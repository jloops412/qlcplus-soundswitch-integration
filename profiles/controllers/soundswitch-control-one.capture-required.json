{
  "schemaVersion": 1,
  "id": "com.emberlights.controller.soundswitch-control-one",
  "name": "SoundSwitch Control One — capture required",
  "version": "0.1.0-capture-required",
  "active": false,
  "deviceMatchers": {
    "input": {
      "nameContains": "Control One",
      "manufacturerId": null,
      "productId": null
    },
    "output": {
      "nameContains": "Control One",
      "manufacturerId": null,
      "productId": null
    }
  },
  "qualification": {
    "state": "captureRequired",
    "inputPacketsCaptured": false,
    "feedbackPacketsCaptured": false,
    "qualifiedAt": null,
    "qualifiedBy": null,
    "notes": "Logical behavior is grounded in official SoundSwitch documentation. No public official MIDI byte chart was found. This profile must remain inactive until input and feedback packets are captured from Joshua's physical unit. OLED is outside V1 unless separately evidenced."
  },
  "evidence": [
    {
      "kind": "officialBehavior",
      "url": "https://www.soundswitch.com/controlone",
      "note": "Official product behavior and control surface."
    },
    {
      "kind": "officialBehavior",
      "url": "https://cdn.inmusicbrands.com/soundswitch/files/User%20Guide%20Control%20One.pdf",
      "note": "Official Control One user guide."
    },
    {
      "kind": "officialBehavior",
      "url": "https://support.soundswitch.com/en/support/solutions/articles/69000858487-soundswitch-autoloop-improvements-in-soundswitch-2-9",
      "note": "Official four-bank, 32-slot, exclusive-bank, All Banks, progress, and script-override behavior."
    }
  ],
  "controls": [
    {
      "id": "transport.playPause",
      "zone": "transport",
      "interaction": "toggle",
      "command": "transport.playing.toggle",
      "implementation": "engineGap",
      "input": null,
      "feedback": [],
      "notes": "Must control performance transport semantics, not stop the EmberLights Runner."
    },
    {
      "id": "transport.tap",
      "zone": "transport",
      "interaction": "momentary",
      "command": "transport.tap",
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "autoloop.scriptOverride",
      "zone": "transport",
      "interaction": "toggle",
      "command": "autoloop.scriptOverride.toggle",
      "implementation": "engineGap",
      "input": null,
      "feedback": []
    },
    {
      "id": "autoloop.bank1",
      "zone": "autoloopBanks",
      "interaction": "selection",
      "command": "autoloop.bankFilter.setEnabled",
      "arguments": { "bankWindowIndex": 0 },
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "autoloop.bank2",
      "zone": "autoloopBanks",
      "interaction": "selection",
      "command": "autoloop.bankFilter.setEnabled",
      "arguments": { "bankWindowIndex": 1 },
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "autoloop.bank3",
      "zone": "autoloopBanks",
      "interaction": "selection",
      "command": "autoloop.bankFilter.setEnabled",
      "arguments": { "bankWindowIndex": 2 },
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "autoloop.bank4",
      "zone": "autoloopBanks",
      "interaction": "selection",
      "command": "autoloop.bankFilter.setEnabled",
      "arguments": { "bankWindowIndex": 3 },
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "autoloop.allBanks",
      "zone": "autoloopBanks",
      "interaction": "chord",
      "command": "autoloop.bankFilter.enableAll",
      "arguments": { "modifier": "shift", "control": "bank1-4" },
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "pads.autoloop",
      "zone": "pads1-32",
      "interaction": "selection",
      "command": "autoloop.launch",
      "arguments": { "slotRange": [0, 31], "bank": "selectedWindowBank" },
      "implementation": "ready",
      "input": null,
      "feedback": [],
      "notes": "One captured pattern is required per physical pad; active/progress feedback must also be captured."
    },
    {
      "id": "pads.staticLook",
      "zone": "pads1-32",
      "interaction": "selection",
      "command": "staticLook.toggle",
      "arguments": { "slotRange": [0, 31], "mode": "staticLooks" },
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "intensity.autoloop",
      "zone": "touchStrip",
      "interaction": "absolute",
      "command": "autoloop.intensity.set",
      "implementation": "engineGap",
      "input": null,
      "feedback": []
    },
    {
      "id": "intensity.trackScript",
      "zone": "touchStrip",
      "interaction": "absolute",
      "command": "trackScript.intensity.set",
      "implementation": "engineGap",
      "input": null,
      "feedback": []
    },
    {
      "id": "intensity.group1-4",
      "zone": "touchStrip",
      "interaction": "absolute",
      "command": "override.groupProperty.set",
      "arguments": { "groupRoleRange": [1, 4], "property": "intensity" },
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "override.color",
      "zone": "overrides",
      "interaction": "absolute",
      "command": "override.color.set",
      "implementation": "engineGap",
      "input": null,
      "feedback": []
    },
    {
      "id": "override.position",
      "zone": "overrides",
      "interaction": "absolute",
      "command": "override.position.set",
      "implementation": "engineGap",
      "input": null,
      "feedback": []
    },
    {
      "id": "override.strobe",
      "zone": "overrides",
      "interaction": "absolute",
      "command": "override.groupProperty.set",
      "arguments": { "property": "strobe" },
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "override.movement",
      "zone": "overrides",
      "interaction": "absolute",
      "command": "override.movement.set",
      "implementation": "engineGap",
      "input": null,
      "feedback": []
    },
    {
      "id": "override.fullWhite",
      "zone": "special",
      "interaction": "momentary",
      "command": "staticLook.hold",
      "arguments": { "role": "workWhite" },
      "implementation": "engineGap",
      "input": null,
      "feedback": []
    },
    {
      "id": "output.blackout",
      "zone": "special",
      "interaction": "toggle",
      "command": "output.blackout.toggle",
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "override.uv",
      "zone": "special",
      "interaction": "momentary",
      "command": "override.groupProperty.set",
      "arguments": { "property": "uv" },
      "implementation": "ready",
      "input": null,
      "feedback": []
    },
    {
      "id": "hazard.smokeHaze",
      "zone": "special",
      "interaction": "momentary",
      "command": "safety.hazard.setArmed",
      "implementation": "captureOnly",
      "input": null,
      "feedback": [],
      "notes": "A qualified binding must preserve EmberLights hazard arming and output safety gates."
    },
    {
      "id": "controller.shift",
      "zone": "modifier",
      "interaction": "momentary",
      "command": "controller.layer.shift",
      "implementation": "captureOnly",
      "input": null,
      "feedback": []
    }
  ]
}
