  "controlledCases": [
    {
      "caseId": "skin.minimal-primitives",
      "purpose": "Prove bounded skin XML and asset inventory plus primitive/layout proposals.",
      "sourceArtifacts": [
        "skin.xml",
        "skin.image"
      ],
      "sourceFeatures": [
        "rootDimensions",
        "nestedContainer",
        "button",
        "slider",
        "text",
        "referencedImage",
        "unknownElement"
      ],
      "expected": [
        {
          "sourcePointer": "skin.xml#/skin",
          "targetKind": "designerArtboard",
          "status": "exact"
        },
        {
          "sourcePointer": "skin.xml#/skin/button[1]",
          "targetKind": "componentProposal",
          "status": "translated"
        },
        {
          "sourcePointer": "skin.xml#/skin/unknown[1]",
          "targetKind": "opaqueAttachment",
          "status": "opaque"
        }
      ]
    },
    {
      "caseId": "pads.shift-parameters-feedback",
      "purpose": "Prove pad pages, modifiers, parameters, and feedback mapping without executing source actions.",
      "sourceArtifacts": [
        "skin.xml"
      ],
      "sourceFeatures": [
        "padPage",
        "ordinaryPad",
        "shiftPad",
        "pressureOrValueAction",
        "pageParameter",
        "padMenu",
        "feedbackColor",
        "unknownAction"
      ],
      "expected": [
        {
          "sourcePointer": "pads/page[1]",
          "targetKind": "customPageProposal",
          "status": "translated"
        },
        {
          "sourcePointer": "pads/page[1]/pad[unknownAction]",
          "targetKind": "opaqueActionEvidence",
          "status": "opaque"
        }
      ]
    },
    {
      "caseId": "controller.definition-and-mapper",
      "purpose": "Prove device definition remains separate from action mapping and portable output is redacted.",
      "sourceArtifacts": [
        "controller.definition",
        "controller.mapper"
      ],
      "sourceFeatures": [
        "button",
        "absoluteFader",
        "highResolutionControl",
        "relativeEncoder",
        "led",
        "rgbOutput",
        "textDisplay",
        "physicalPadGeometry",
        "knownAction",
        "unknownAction",
        "machineSpecificIdentifier"
      ],
      "expected": [
        {
          "sourcePointer": "controller.definition#/device",
          "targetKind": "controllerDefinitionProposal",
          "status": "translated"
        },
        {
          "sourcePointer": "controller.mapper#/mapper/map[knownAction]",
          "targetKind": "controllerBindingProposal",
          "status": "translated"
        },
        {
