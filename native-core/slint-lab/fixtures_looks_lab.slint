import { Button, LineEdit, ScrollView, Slider } from "std-widgets.slint";
import { Hairline, SectionTitle, StateBadge, StatusPill, Theme, ValueReadout } from "ember_ui_primitives.slint";

// Shared D-097 product/bounded-lab surface. Domain state is supplied by
// FixturesLooksShellModel; this file owns presentation only, and the explicit
// product-shell property selects the installed chrome or non-product lab label.
export struct ShellListItem {
    stable-id: string,
    title: string,
    detail: string,
    badge: string,
    selected: bool,
    warning: bool,
}

export struct ChoiceTileItem {
    choice-id: string,
    parameter-id: string,
    title: string,
    detail: string,
    ownership: string,
    active: bool,
    selected: bool,
    enabled: bool,
    safety-restricted: bool,
}

export struct ControlGroupItem {
    stable-id: string,
    title: string,
    count-label: string,
    selected: bool,
    advanced: bool,
}

export struct ParameterControlItem {
    choice-id: string,
    parameter-id: string,
    section-label: string,
    title: string,
    detail: string,
    kind: string,
    ownership: string,
    value: float,
    enabled: bool,
    safety-restricted: bool,
    mixed: bool,
    active: bool,
    profile-function: bool,
}

export struct ParameterFamilyItem {
    stable-id: string,
    parameter-id: string,
    section-label: string,
    title: string,
    detail: string,
    kind: string,
    ownership: string,
    ownership-choice-id: string,
    value-controls: [ParameterControlItem],
    choices: [ChoiceTileItem],
    value-count: int,
    choice-count: int,
    enabled: bool,
    safety-restricted: bool,
    mixed: bool,
}

component LibraryRow inherits Rectangle {
    in property <ShellListItem> item;
    callback selected(string);
    height: 66px;
    border-radius: 6px;
    border-width: item.selected ? 1px : 0px;
    border-color: item.warning ? Theme.warn : item.selected ? Theme.brand : #00000000;
    background: item.selected ? Theme.brand-soft : touch.has-hover ? Theme.control : Theme.panel;
    accessible-role: list-item;
    accessible-label: item.title + ". " + item.detail + ". " + item.badge;
    accessible-item-selectable: true;
    accessible-item-selected: item.selected;

    HorizontalLayout {
        padding: 9px;
        spacing: 9px;
        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: item.warning ? Theme.warn : item.selected ? Theme.brand : Theme.border;
        }
        VerticalLayout {
            spacing: 3px;
            Text {
                text: item.title;
                color: Theme.text;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: item.detail;
                color: Theme.text-muted;
                font-size: 10px;
                overflow: elide;
            }
            Text {
                text: item.badge;
                color: item.warning ? Theme.warn : Theme.text-secondary;
                font-size: 10px;
                overflow: elide;
            }
        }
    }
    touch := TouchArea { clicked => { root.selected(item.stable-id); } }
}

component ControlGroupChip inherits Rectangle {
    in property <ControlGroupItem> item;
    callback selected(string);
    height: 42px;
    min-width: 92px;
    border-radius: 6px;
    border-width: item.selected ? 1px : 0px;
    border-color: item.selected ? Theme.brand : #00000000;
    background: item.selected ? Theme.brand-soft : touch.has-hover ? Theme.control-hover : Theme.control;
    accessible-role: radio-button;
    accessible-label: item.title + ", " + item.count-label;
    accessible-checked: item.selected;

    VerticalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 1px;
        Text {
            text: item.title;
            color: item.selected ? Theme.text : Theme.text-secondary;
            font-size: 11px;
            font-weight: item.selected ? 650 : 500;
            horizontal-alignment: center;
        }
        Text {
            text: item.count-label;
            color: item.advanced ? Theme.warn : Theme.text-muted;
            font-size: 9px;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.selected(item.stable-id); } }
}

component OwnerSegment inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> segment-value;
    in property <bool> enabled: true;
    callback selected(string);
    height: 34px;
    min-width: 86px;
    border-radius: 5px;
    border-width: value == segment-value ? 1px : 0px;
    border-color: value == segment-value ? Theme.brand : #00000000;
    background: value == segment-value ? Theme.brand-soft : touch.has-hover ? Theme.control-hover : Theme.control;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: radio-button;
    accessible-label: label;
    accessible-checked: value == segment-value;
    accessible-enabled: root.enabled;
    Text {
        text: root.label;
        color: value == segment-value ? Theme.text : Theme.text-secondary;
        font-size: 11px;
        font-weight: value == segment-value ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.selected(root.segment-value); }
    }
}

component MiniOwnerSegment inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> segment-value;
    in property <bool> enabled: true;
    callback selected(string);
    height: 24px;
    min-width: 20px;
    border-radius: 4px;
    border-width: value == segment-value ? 1px : 0px;
    border-color: value == segment-value ? Theme.brand : #00000000;
    background: value == segment-value ? Theme.brand-soft : touch.has-hover ? Theme.control-hover : Theme.control;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: radio-button;
    accessible-label: label;
    accessible-checked: value == segment-value;
    accessible-enabled: root.enabled;
    Text {
        text: root.label;
        color: value == segment-value ? Theme.text : Theme.text-muted;
        font-size: 8px;
        font-weight: value == segment-value ? 650 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.selected(root.segment-value); }
    }
}

component OwnershipStrip inherits Rectangle {
    in property <string> value: "release";
    in property <bool> enabled: true;
    callback selected(string);
    height: 34px;
    background: #00000000;
    HorizontalLayout {
        spacing: 4px;
        OwnerSegment {
            label: "Release";
            value: root.value;
            segment-value: "release";
            enabled: root.enabled;
            selected(value) => { root.selected(value); }
        }
        OwnerSegment {
            label: "Set";
            value: root.value;
            segment-value: "set";
            enabled: root.enabled;
            selected(value) => { root.selected(value); }
        }
        OwnerSegment {
            label: "Force zero";
            value: root.value;
            segment-value: "forceZero";
            enabled: root.enabled;
            selected(value) => { root.selected(value); }
        }
    }
}

// A read-only summary of the selected Look's ordinary RGBWA emitter values.
// The individual profile-backed controls below remain authoritative and keep
// every additional emitter (UV, CMY, Lime, Indigo, and so on) reachable.
component ColorMixerSummary inherits Rectangle {
    in property <float> red: 0;
    in property <float> green: 0;
    in property <float> blue: 0;
    in property <float> white: 0;
    in property <float> amber: 0;
    in property <string> detail;
    height: 58px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    background: Theme.canvas;
    accessible-role: AccessibleRole.region;
    accessible-label: "Profile-backed RGBWA emitter preview. " + root.detail;

    Rectangle { background: #ef5a5a; opacity: root.red * 0.72; }
    Rectangle { background: #49c77a; opacity: root.green * 0.72; }
    Rectangle { background: #4fa5de; opacity: root.blue * 0.72; }
    Rectangle { background: #f0a34a; opacity: root.amber * 0.62; }
    Rectangle { background: #ece6d4; opacity: root.white * 0.62; }
    Rectangle { background: #11141666; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: center;
        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.text;
            background: Theme.brand;
        }
        VerticalLayout {
            spacing: 2px;
            Text { text: "COLOR OUTPUT"; color: Theme.text; font-size: 10px; font-weight: 700; }
            Text { text: root.detail; color: Theme.text-secondary; font-size: 10px; overflow: elide; }
        }
        Rectangle { horizontal-stretch: 1; background: #00000000; }
        Text {
            text: "R " + round(root.red * 100) + "  G " + round(root.green * 100) + "  B " + round(root.blue * 100);
            color: Theme.text;
            font-size: 10px;
            font-weight: 600;
        }
    }
}

component ColorChannel inherits Rectangle {
    in property <string> choice-id;
    in property <string> label;
    in property <brush> channel-color;
    in-out property <float> value: 0;
    in property <string> ownership: "release";
    in property <bool> enabled: true;
    callback value-changed(string, float);
    callback ownership-changed(string, string);
    min-width: 74px;
    height: 198px;
    border-radius: 7px;
    border-width: 1px;
    border-color: ownership == "set" ? channel-color : Theme.border-subtle;
    background: Theme.panel;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.label + " emitter. " +
        (root.ownership == "set" ? round(root.value * 100) + "% set" :
         root.ownership == "forceZero" ? "forced zero" : "released");

    VerticalLayout {
        padding: 9px;
        spacing: 6px;
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 10px;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 68px;
            border-radius: 4px;
            background: Theme.control;
            Rectangle {
                y: parent.height * (1 - root.value);
                height: parent.height * root.value;
                width: parent.width;
                border-radius: 4px;
                background: root.channel-color;
                opacity: root.ownership == "set" ? 0.92 : 0.25;
            }
        }
        Slider {
            value: root.value;
            minimum: 0;
            maximum: 1;
            enabled: root.enabled && root.ownership == "set";
            changed(value) => {
                root.value = value;
                root.value-changed(root.choice-id, value);
            }
        }
        Text {
            text: root.ownership == "forceZero" ? "OFF" : root.ownership == "release" ? "RELEASED" : round(root.value * 100) + "%";
            color: root.ownership == "set" ? root.channel-color : Theme.text-muted;
            font-size: 9px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: 2px;
            MiniOwnerSegment { label: "REL"; value: root.ownership; segment-value: "release"; enabled: root.enabled; selected(value) => { root.ownership-changed(root.choice-id, value); } }
            MiniOwnerSegment { label: "SET"; value: root.ownership; segment-value: "set"; enabled: root.enabled; selected(value) => { root.ownership-changed(root.choice-id, value); } }
            MiniOwnerSegment { label: "0"; value: root.ownership; segment-value: "forceZero"; enabled: root.enabled; selected(value) => { root.ownership-changed(root.choice-id, value); } }
        }
    }
}

component XYPad inherits Rectangle {
    in property <string> pan-choice-id;
    in property <string> tilt-choice-id;
    in-out property <float> pan: 0.5;
    in-out property <float> tilt: 0.5;
    in property <string> ownership: "release";
    in property <bool> enabled: true;
    callback value-changed(string, float);
    callback ownership-changed(string, string);
    min-height: 240px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    background: Theme.panel;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: "Position. Pan " + round(root.pan * 100) +
        " percent. Tilt " + round(root.tilt * 100) + " percent.";

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text {
                text: "Position";
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            Text {
                text: "Pan " + round(root.pan * 100) + "%  •  Tilt " + round(root.tilt * 100) + "%";
                color: Theme.text-muted;
                font-size: 10px;
                horizontal-alignment: right;
            }
        }
        pad := Rectangle {
            min-height: 150px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.canvas;
            Rectangle { x: parent.width / 2; width: 1px; height: parent.height; background: Theme.border-subtle; }
            Rectangle { y: parent.height / 2; height: 1px; width: parent.width; background: Theme.border-subtle; }
            Rectangle {
                x: root.pan * (parent.width - self.width);
                y: (1 - root.tilt) * (parent.height - self.height);
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 2px;
                border-color: Theme.focus;
                background: Theme.brand;
                opacity: root.ownership == "set" ? 1 : 0.35;
            }
            touch := TouchArea {
                enabled: root.enabled && root.ownership == "set";
                moved => {
                    root.pan = max(0, min(1, self.mouse-x / self.width));
                    root.tilt = max(0, min(1, 1 - self.mouse-y / self.height));
                    root.value-changed(root.pan-choice-id, root.pan);
                    root.value-changed(root.tilt-choice-id, root.tilt);
                }
            }
        }
        OwnershipStrip {
            value: root.ownership;
            enabled: root.enabled;
            selected(value) => {
                root.ownership-changed(root.pan-choice-id, value);
                root.ownership-changed(root.tilt-choice-id, value);
            }
        }
    }
}

component ChoiceTile inherits Rectangle {
    in property <ChoiceTileItem> item;
    callback selected(string);
    height: 72px;
    min-width: 112px;
    border-radius: 6px;
    border-width: item.active || item.selected ? 2px : 1px;
    border-color: item.safety-restricted ? Theme.warn : item.active ? Theme.good : item.selected ? Theme.brand : Theme.border-subtle;
    background: item.active ? #173225 : item.selected ? Theme.brand-soft : touch.has-hover ? Theme.control : Theme.panel;
    opacity: item.enabled ? 1 : 0.45;
    accessible-role: radio-button;
    accessible-label: item.title + ". " + item.detail;
    accessible-enabled: item.enabled;
    accessible-checked: item.active;
    VerticalLayout {
        padding: 8px;
        spacing: 3px;
        HorizontalLayout {
            spacing: 5px;
            Text {
                text: item.title;
                color: Theme.text;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; background: #00000000; }
            if item.active || item.selected || item.safety-restricted: StateBadge {
                label: item.safety-restricted ? "LIMITED" : item.active ? "ACTIVE" : "SELECTED";
                tone: item.safety-restricted ? Theme.warn : item.active ? Theme.good : Theme.brand;
            }
        }
        Text {
            text: item.safety-restricted ? "Safety-limited • " + item.detail : item.detail;
            color: item.safety-restricted ? Theme.warn : Theme.text-muted;
            font-size: 9px;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: item.enabled;
        clicked => { root.selected(item.choice-id); }
    }
}

// Compact value row used inside one semantic parameter family. Dragging a
// value asserts SET through the existing typed domain path, so operators do
// not have to arm ownership in a separate part of the page first.
component ParameterValueRow inherits Rectangle {
    in property <ParameterControlItem> item;
    in property <bool> enabled: true;
    callback value-changed(string, float);
    min-height: 78px;
    border-radius: 5px;
    border-width: 1px;
    border-color: item.active ? Theme.good : Theme.border-subtle;
    background: Theme.control;
    accessible-role: slider;
    accessible-label: item.title + ". " + item.detail;
    accessible-enabled: root.enabled && item.enabled;

    VerticalLayout {
        padding: 9px;
        spacing: 6px;
        HorizontalLayout {
            Text {
                text: item.title;
                color: Theme.text;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; background: #00000000; }
            ValueReadout {
                label: item.mixed ? "MIXED" : round(item.value * 100) + "%";
                tone: item.mixed ? Theme.warn : item.active ? Theme.good : Theme.text-secondary;
            }
        }
        Slider {
            value: item.value;
            minimum: 0;
            maximum: 1;
            enabled: root.enabled && item.enabled;
            changed(value) => { root.value-changed(item.choice-id, value); }
        }
    }
}

// One property-scoped card keeps continuous values, exact profile choices,
// availability and RELEASE/SET/FORCE_ZERO ownership in one operator task.
component ParameterFamilyCard inherits Rectangle {
    in property <ParameterFamilyItem> item;
    in property <bool> enabled: true;
    callback select-choice(string);
    callback value-changed(string, float);
    callback ownership-changed(string, string);
    min-height: 132px;
    border-radius: 8px;
    border-width: 1px;
    border-color: item.safety-restricted ? Theme.warn : item.mixed ? Theme.warn : Theme.border-subtle;
    background: Theme.panel;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: item.title + ". " + item.detail;

    VerticalLayout {
        padding: 12px;
        spacing: 9px;
        HorizontalLayout {
            VerticalLayout {
                spacing: 2px;
                Text { text: item.title; color: Theme.text; font-size: 13px; font-weight: 650; }
                Text { text: item.section-label + " • " + item.kind; color: Theme.text-muted; font-size: 9px; }
            }
            Rectangle { horizontal-stretch: 1; background: #00000000; }
            StateBadge {
                label: item.mixed ? "MIXED" : item.ownership == "forceZero" ? "OFF" : item.ownership == "set" ? "SET" : "RELEASED";
                tone: item.mixed ? Theme.warn : item.ownership == "set" ? Theme.good : Theme.text-muted;
            }
        }
        Text {
            text: item.detail;
            color: item.safety-restricted ? Theme.warn : Theme.text-secondary;
            font-size: 10px;
            wrap: word-wrap;
        }
        for control in item.value-controls: ParameterValueRow {
            item: control;
            enabled: root.enabled;
            value-changed(id, value) => { root.value-changed(id, value); }
        }
        if item.choice-count > 0: ScrollView {
            height: 84px;
            HorizontalLayout {
                spacing: 8px;
                for choice in item.choices: ChoiceTile {
                    item: choice;
                    selected(id) => { root.select-choice(id); }
                }
            }
        }
        OwnershipStrip {
            value: item.ownership;
            enabled: root.enabled && item.enabled;
            selected(value) => {
                root.ownership-changed(item.ownership-choice-id, value);
            }
        }
    }
}

export component FixturesLooksLab inherits Window {
    in property <bool> product-shell: false;
    title: root.product-shell ? "EmberLights • Studio • Fixtures + Static Looks" : "EmberLights • Fixtures + Static Looks • Slint Lab";
    preferred-width: 1366px;
    preferred-height: 768px;
    min-width: 1366px;
    min-height: 768px;
    background: Theme.app;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    in property <string> project-name: "Ballroom Rig";
    in property <string> save-state: "Saved";
    in property <string> validation-state: "Validated";
    in property <string> output-state: "Dry run";
    in property <string> workspace-message;
    in property <string> preview-status;
    in property <string> preview-detail;
    in property <string> preview-state: "stopped";
    in property <string> preview-mode: "none";
    in property <string> selected-look-name;
    in property <string> selected-target-name;
    in property <string> selected-target-detail;
    in property <bool> can-edit: true;
    in property <bool> can-simulate-preview: true;
    in property <bool> can-physical-preview: false;
    in property <bool> physical-preview-enabled: false;
    in property <bool> can-save-look: false;
    in property <bool> can-save-project: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> advanced-available: false;
    in property <bool> preview-active: false;
    in property <int> preview-remaining-seconds: 0;
    in property <int> preview-output-cap-percent: 0;
    in property <int> preview-fixture-count: 0;
    in property <bool> live-running: false;
    in property <string> history-state;
    in property <string> build-label;
    in property <bool> has-project-path: false;
    in-out property <bool> advanced-open: false;
    in-out property <string> profile-search;
    in-out property <string> look-search;
    in-out property <string> parameter-search;
    in property <[ShellListItem]> profile-items;
    in property <[ShellListItem]> target-items;
    in property <[ShellListItem]> look-items;
    in property <[ShellListItem]> diagnostic-items;
    in property <[ControlGroupItem]> control-group-items;
    in property <[ParameterControlItem]> color-items;
    in property <[ParameterFamilyItem]> parameter-family-items;
    in property <string> control-summary;
    in property <string> advanced-profile-title;
    in property <string> advanced-profile-detail;
    in property <string> advanced-patch-detail;
    in property <string> selected-control-group: "all";
    in property <int> visible-control-count: 0;
    in property <int> color-item-count: 0;
    in property <bool> color-preview-visible: false;
    in property <float> color-preview-red: 0;
    in property <float> color-preview-green: 0;
    in property <float> color-preview-blue: 0;
    in property <float> color-preview-white: 0;
    in property <float> color-preview-amber: 0;
    in property <string> color-preview-detail;
    in property <int> parameter-family-count: 0;
    in property <int> diagnostic-item-count: 0;
    in property <bool> xy-visible: false;
    in property <string> pan-choice-id;
    in property <float> pan-value: 0.5;
    in property <string> tilt-choice-id;
    in property <float> tilt-value: 0.58;
    in property <string> position-ownership: "set";

    callback select-profile(string);
    callback select-target(string);
    callback select-look(string);
    callback select-choice(string);
    callback profile-search-changed(string);
    callback look-search-changed(string);
    callback parameter-search-changed(string);
    callback select-control-group(string);
    callback control-value-changed(string, float);
    callback control-ownership-changed(string, string);
    callback preview-simulate();
    callback preview-physical();
    callback preview-stop();
    callback save-look();
    callback save-project();
    callback save-project-as();
    callback new-project();
    callback open-project();
    callback open-safe();
    callback undo();
    callback redo();
    callback create-look();
    callback duplicate-look();
    callback open-advanced();

    property <length> library-width: 286px;
    property <length> looks-width: 310px;
    property <length> header-height: 64px;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: root.header-height;
            background: Theme.chrome;
            border-width: 0px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 14px;
                spacing: 14px;
                alignment: center;
                HorizontalLayout {
                    width: root.library-width - 16px;
                    spacing: 10px;
                    alignment: center;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 9px;
                        background: Theme.brand;
                        Text {
                            text: "E";
                            color: #17120d;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: "EMBERLIGHTS"; color: Theme.text; font-size: 11px; font-weight: 700; }
                        Text { text: root.project-name + "  •  " + root.save-state; color: Theme.text-muted; font-size: 10px; overflow: elide; }
                    }
                }
                StatusPill { label: "Project"; state: root.validation-state; tone: root.validation-state == "Validated" ? Theme.good : Theme.warn; }
                StatusPill { label: "Surface"; state: root.product-shell ? "Studio beta" : "Studio lab"; tone: Theme.brand; }
                StatusPill {
                    label: "Output";
                    state: root.output-state;
                    tone: root.preview-mode == "physical" ? Theme.warn : root.preview-mode == "simulation" ? Theme.good : Theme.text-muted;
                }
                Rectangle { horizontal-stretch: 1; background: #00000000; }
                if root.product-shell: Button { text: "New"; clicked => { root.new-project(); } }
                if root.product-shell: Button { text: "Open"; clicked => { root.open-project(); } }
                if root.product-shell: Button { text: "Safe / Live"; clicked => { root.open-safe(); } }
                Button {
                    text: root.advanced-open ? "Close Advanced" : "Advanced";
                    enabled: root.advanced-available;
                    clicked => {
                        root.advanced-open = !root.advanced-open;
                        root.open-advanced();
                    }
                }
            }
        }
        Hairline { }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: root.library-width;
                background: Theme.panel;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    SectionTitle { title: "Fixture library"; detail: "Profiles, provenance, patch and groups"; }
                    LineEdit {
                        text <=> root.profile-search;
                        placeholder-text: "Search profiles, maker, model or mode";
                        edited => { root.profile-search-changed(self.text); }
                    }
                    Text { text: "PROFILES"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                    ScrollView {
                        vertical-stretch: 3;
                        VerticalLayout {
                            spacing: 6px;
                            for item in root.profile-items: LibraryRow {
                                item: item;
                                selected(id) => { root.select-profile(id); }
                            }
                        }
                    }
                    Hairline { }
                    Text { text: "PATCH TARGETS"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                    ScrollView {
                        vertical-stretch: 2;
                        VerticalLayout {
                            spacing: 6px;
                            for item in root.target-items: LibraryRow {
                                item: item;
                                selected(id) => { root.select-target(id); }
                            }
                        }
                    }
                }
            }
            Hairline { width: 1px; }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.canvas;
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    Rectangle {
                        height: 70px;
                        background: #00000000;
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: root.selected-look-name; color: Theme.text; font-size: 21px; font-weight: 650; overflow: elide; }
                                Text { text: root.selected-target-name + "  •  " + root.selected-target-detail; color: Theme.text-muted; font-size: 11px; overflow: elide; }
                            }
                            Rectangle { horizontal-stretch: 1; background: #00000000; }
                            Button { text: "Undo"; enabled: root.can-undo; clicked => { root.undo(); } }
                            Button { text: "Redo"; enabled: root.can-redo; clicked => { root.redo(); } }
                            Button {
                                text: root.has-project-path ? "Save Project" : "Save Project As";
                                enabled: root.has-project-path ? root.can-save-project : root.product-shell;
                                clicked => {
                                    if root.has-project-path { root.save-project(); }
                                    else { root.save-project-as(); }
                                }
                            }
                            Button { text: "Duplicate"; enabled: root.can-edit && !root.can-save-look; clicked => { root.duplicate-look(); } }
                            Button { text: "Save Look"; primary: true; enabled: root.can-edit && root.can-save-look; clicked => { root.save-look(); } }
                        }
                    }
                    Rectangle {
                        height: 76px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.preview-state == "fault" || root.preview-state == "timedOut" ? #8a3939 : root.preview-mode == "physical" ? #8b642d : root.can-simulate-preview ? #275b3e : Theme.border-subtle;
                        background: root.preview-state == "fault" || root.preview-state == "timedOut" ? #321a1b : root.preview-mode == "physical" ? #2b2417 : root.preview-active ? #15281e : Theme.panel;
                        accessible-role: AccessibleRole.groupbox;
                        accessible-label: root.preview-status + ". " + root.preview-detail;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            spacing: 12px;
                            alignment: center;
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 5px;
                                background: root.preview-state == "fault" || root.preview-state == "timedOut" ? Theme.danger : root.preview-mode == "physical" ? Theme.warn : root.preview-active ? Theme.good : Theme.text-muted;
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: root.preview-status;
                                    color: Theme.text;
                                    font-size: 12px;
                                    font-weight: 650;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.preview-detail;
                                    color: root.preview-mode == "physical" ? Theme.warn : Theme.text-muted;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: #00000000; }
                            if !root.preview-active: HorizontalLayout {
                                spacing: 7px;
                                Button {
                                    text: "Simulate";
                                    enabled: root.can-simulate-preview;
                                    clicked => { root.preview-simulate(); }
                                }
                                Button {
                                    text: "Preview fixtures";
                                    enabled: root.can-physical-preview;
                                    clicked => { root.preview-physical(); }
                                }
                            }
                            if root.preview-active: Button {
                                text: root.preview-mode == "physical" ? "Blackout & stop" : "Stop simulation";
                                clicked => { root.preview-stop(); }
                            }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 14px;
                            HorizontalLayout {
                                Text { text: "FIXTURE PARAMETERS"; color: Theme.text; font-size: 13px; font-weight: 700; }
                                Text { text: root.control-summary; color: Theme.text-muted; font-size: 10px; horizontal-alignment: right; overflow: elide; }
                            }
                            Text {
                                text: "Profile-backed controls • stable across Static Looks, Autoloops, Live, mappings and future skins";
                                color: Theme.text-muted;
                                font-size: 10px;
                                overflow: elide;
                            }
                            LineEdit {
                                text <=> root.parameter-search;
                                placeholder-text: "Search fixture parameters, functions or profile ranges";
                                edited => { root.parameter-search-changed(self.text); }
                            }
                            ScrollView {
                                height: 48px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    for item in root.control-group-items: ControlGroupChip {
                                        item: item;
                                        selected(id) => { root.select-control-group(id); }
                                    }
                                }
                            }
                            if root.visible-control-count == 0: Rectangle {
                                height: 92px;
                                border-radius: 7px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                background: Theme.panel;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 5px;
                                    Text { text: "No matching fixture parameters"; color: Theme.text; font-size: 13px; font-weight: 600; }
                                    Text { text: "Choose All, select another attribute group, clear search, or repair the fixture profile."; color: Theme.text-muted; font-size: 10px; }
                                }
                            }
                            if root.color-item-count > 0: Text { text: "COLOR EMITTERS"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                            if root.color-preview-visible: ColorMixerSummary {
                                red: root.color-preview-red;
                                green: root.color-preview-green;
                                blue: root.color-preview-blue;
                                white: root.color-preview-white;
                                amber: root.color-preview-amber;
                                detail: root.color-preview-detail;
                            }
                            if root.color-item-count > 0: Rectangle {
                                min-height: 224px;
                                border-radius: 7px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                background: Theme.raised;
                                ScrollView {
                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        for item in root.color-items: ColorChannel {
                                            choice-id: item.choice-id;
                                            label: item.title;
                                            channel-color: item.parameter-id == "red" ? #ef5a5a : item.parameter-id == "green" ? #49c77a : item.parameter-id == "blue" ? #4fa5de : item.parameter-id == "amber" ? #f0a34a : item.parameter-id == "uv" || item.parameter-id == "indigo" ? #9674e8 : item.parameter-id == "cyan" ? #44cfd0 : item.parameter-id == "magenta" ? #dc65bb : item.parameter-id == "yellow" ? #dfd35a : item.parameter-id == "lime" ? #9bd65a : #ece6d4;
                                            value: item.value;
                                            ownership: item.ownership;
                                            enabled: root.can-edit && item.enabled;
                                            value-changed(id, value) => { root.control-value-changed(id, value); }
                                            ownership-changed(id, value) => { root.control-ownership-changed(id, value); }
                                        }
                                    }
                                }
                            }
                            if root.xy-visible: Text { text: "POSITION"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                            if root.xy-visible: XYPad {
                                pan-choice-id: root.pan-choice-id;
                                tilt-choice-id: root.tilt-choice-id;
                                pan: root.pan-value;
                                tilt: root.tilt-value;
                                ownership: root.position-ownership;
                                enabled: root.can-edit;
                                value-changed(id, value) => { root.control-value-changed(id, value); }
                                ownership-changed(id, value) => { root.control-ownership-changed(id, value); }
                            }
                            if root.parameter-family-count > 0: Text { text: "PARAMETER CARDS"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                            for item in root.parameter-family-items: ParameterFamilyCard {
                                item: item;
                                enabled: root.can-edit;
                                select-choice(id) => { root.select-choice(id); }
                                value-changed(id, value) => { root.control-value-changed(id, value); }
                                ownership-changed(id, value) => { root.control-ownership-changed(id, value); }
                            }
                            Rectangle { height: 16px; background: #00000000; }
                        }
                    }
                }
            }
            Hairline { width: 1px; }
            Rectangle {
                width: root.looks-width;
                background: Theme.panel;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    SectionTitle { title: "Static Looks"; detail: "Reusable scenes with explicit property ownership"; }
                    LineEdit {
                        text <=> root.look-search;
                        placeholder-text: "Search Looks, target or property";
                        edited => { root.look-search-changed(self.text); }
                    }
                    Button { height: 34px; text: "New Look"; primary: true; enabled: root.can-edit && !root.can-save-look; clicked => { root.create-look(); } }
                    Text { text: "LOOK LIBRARY"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for item in root.look-items: LibraryRow {
                                item: item;
                                selected(id) => { root.select-look(id); }
                            }
                        }
                    }
                    Rectangle {
                        height: 92px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 5px;
                            Text { text: "WHAT OWNS OUTPUT?"; color: Theme.text-muted; font-size: 9px; font-weight: 700; }
                            Text { text: "Release"; color: Theme.text; font-size: 11px; font-weight: 600; }
                            Text { text: "Lower Track Script or Autoloop continues."; color: Theme.text-muted; font-size: 10px; }
                            Text { text: "Set and Force zero are explicit Look ownership."; color: Theme.text-secondary; font-size: 10px; }
                        }
                    }
                }
            }
        }
        Hairline { }
        Rectangle {
            height: 28px;
            background: Theme.chrome;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: center;
                Text { text: root.workspace-message; color: Theme.text-muted; font-size: 10px; overflow: elide; }
                Rectangle { horizontal-stretch: 1; background: #00000000; }
                Text { text: root.history-state; color: Theme.text-secondary; font-size: 9px; }
                Text {
                    text: root.product-shell ? root.build-label + "  •  Powered by Slint 1.17.1" : "Slint 1.17.1 LAB  •  not a product preview";
                    color: root.product-shell ? Theme.text-muted : Theme.warn;
                    font-size: 9px;
                    font-weight: root.product-shell ? 500 : 700;
                }
            }
        }
    }

    if root.advanced-open: Rectangle {
        x: parent.width - self.width;
        y: root.header-height + 1px;
        width: 420px;
        height: parent.height - root.header-height - 29px;
        background: #14191deF;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000088;
        drop-shadow-offset-x: -6px;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: "Advanced fixture diagnostics drawer";
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                Text { text: "Advanced fixture diagnostics"; color: Theme.text; font-size: 16px; font-weight: 650; }
                Rectangle { horizontal-stretch: 1; background: #00000000; }
                Button { text: "Close"; clicked => { root.advanced-open = false; root.open-advanced(); } }
            }
            Rectangle {
                height: 58px;
                border-radius: 6px;
                border-width: 1px;
                border-color: #725328;
                background: #2b2417;
                Text {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    text: "Raw DMX is evidence, not the ordinary authoring vocabulary. Changes here belong to profile editing, testing, or troubleshooting.";
                    color: Theme.warn;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
            Text { text: "PROFILE PROVENANCE"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
            Rectangle {
                height: 96px;
                border-radius: 6px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border-subtle;
                VerticalLayout {
                    padding: 10px;
                    spacing: 5px;
                    Text { text: root.advanced-profile-title; color: Theme.text; font-size: 11px; font-weight: 600; overflow: elide; }
                    Text { text: root.advanced-profile-detail; color: Theme.text-muted; font-size: 10px; overflow: elide; }
                    Text { text: root.advanced-patch-detail; color: Theme.text-muted; font-size: 10px; overflow: elide; }
                    Text { text: "Validation: exact profile-backed mapping"; color: Theme.good; font-size: 10px; }
                }
            }
            Text { text: "SELECTED CONTROL DIAGNOSTICS"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    if root.diagnostic-item-count == 0: Rectangle {
                        height: 72px;
                        border-radius: 5px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        Text { x: 10px; width: parent.width - 20px; height: parent.height; text: "Adjust a continuous control or choose a profile function to inspect its exact per-fixture realization."; color: Theme.text-muted; font-size: 10px; wrap: word-wrap; vertical-alignment: center; }
                    }
                    for item in root.diagnostic-items: Rectangle {
                        height: 72px;
                        border-radius: 5px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: item.warning ? Theme.warn : Theme.border-subtle;
                        VerticalLayout {
                            padding: 9px;
                            spacing: 3px;
                            Text { text: item.title; color: Theme.text; font-size: 10px; font-weight: 600; overflow: elide; }
                            Text { text: item.detail; color: item.warning ? Theme.warn : Theme.text-secondary; font-size: 10px; overflow: elide; }
                            Text { text: item.badge; color: Theme.text-muted; font-size: 9px; overflow: elide; }
                        }
                    }
                }
            }
            Text {
                text: "Profile editing stays outside this focused lab.";
                color: Theme.text-muted;
                font-size: 10px;
                wrap: word-wrap;
            }
        }
    }
}
