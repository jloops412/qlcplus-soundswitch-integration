<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.3.0 GIT</Version>
  <Author>QLC+ SoundSwitch Integration contributors</Author>
 </Creator>
 <Manufacturer>Both Lighting</Manufacturer>
 <Model>IR-4 (BOIR4)</Model>
 <Type>Color Changer</Type>
 <!-- Independently authored from the manufacturer BO-IR4 manual, PDF page 5.
      See IR4_DEFINITION_PROVENANCE.md for source hash and scope. -->
 <Channel Name="Master Dimmer" Default="0" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red" Default="0" Preset="IntensityRed"/>
 <Channel Name="Green" Default="0" Preset="IntensityGreen"/>
 <Channel Name="Blue" Default="0" Preset="IntensityBlue"/>
 <Channel Name="White" Default="0" Preset="IntensityWhite"/>
 <Channel Name="Amber" Default="0" Preset="IntensityAmber"/>
 <Channel Name="Purple / UV" Default="0" Preset="IntensityUV"/>
 <Channel Name="Strobe" Default="0">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="255">Strobe (raw range; show uses 0)</Capability>
 </Channel>
 <Channel Name="Program / Macro (Show Uses 0)" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Program selector (raw; see manufacturer manual)</Capability>
 </Channel>
 <Channel Name="Color Selection / Speed (Show Uses 0)" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Color and speed within selected program (raw)</Capability>
 </Channel>
 <Mode Name="10 Channel">
  <Channel Number="0">Master Dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">White</Channel>
  <Channel Number="5">Amber</Channel>
  <Channel Number="6">Purple / UV</Channel>
  <Channel Number="7">Strobe</Channel>
  <Channel Number="8">Program / Macro (Show Uses 0)</Channel>
  <Channel Number="9">Color Selection / Speed (Show Uses 0)</Channel>
  <Head>
   <Channel>0</Channel>
   <Channel>1</Channel>
   <Channel>2</Channel>
   <Channel>3</Channel>
   <Channel>4</Channel>
   <Channel>5</Channel>
   <Channel>6</Channel>
   <Channel>7</Channel>
  </Head>
 </Mode>
</FixtureDefinition>
