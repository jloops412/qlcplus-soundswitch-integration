{
  "schemaVersion": 1,
  "workspace": "safe",
  "variant": "safe",
  "metadata": {
    "descriptionKey": "skin.safe.description",
    "defaultFocus": "safe.blackout",
    "minimumWidth": 640,
    "minimumHeight": 480
  },
  "root": {
    "type": "Column",
    "id": "safe.root",
    "padding": 16,
    "gap": 12,
    "children": [
      {
        "type": "Row",
        "id": "safe.header",
        "gap": 12,
        "align": "center",
        "children": [
          {
            "type": "Label",
            "id": "safe.brand",
            "labelKey": "app.name",
            "accessibility": {
              "role": "heading",
              "nameKey": "app.name"
            }
          },
          {
            "type": "Label",
            "id": "safe.project",
            "labelKey": "project.active.label",
            "value": {
              "state": "project.active.name",
              "format": "plain"
            }
          },
          {
            "type": "Spacer",
            "id": "safe.headerSpacer",
            "flexGrow": 1
          },
          {
            "type": "StatusBadge",
            "id": "safe.runnerStatus",
            "labelKey": "runner.status.label",
            "state": {
              "state": "runner.health",
              "format": "status"
            },
            "accessibility": {
              "role": "status",
              "nameKey": "runner.status.label"
            }
          }
        ]
      },
      {
        "type": "Grid",
        "id": "safe.healthGrid",
        "columns": 3,
        "rowGap": 8,
        "columnGap": 8,
        "children": [
          {
            "type": "StatusBadge",
            "id": "safe.djStatus",
            "labelKey": "connection.dj.label",
            "state": {
              "state": "connection.dj.status",
              "format": "status"
            }
          },
          {
            "type": "StatusBadge",
            "id": "safe.universe1",
            "labelKey": "output.universe1.label",
            "state": {
              "state": "output.universe[0].status",
              "format": "status"
            }
          },
          {
            "type": "StatusBadge",
            "id": "safe.universe2",
            "labelKey": "output.universe2.label",
            "state": {
              "state": "output.universe[1].status",
              "format": "status"
            }
          },
          {
            "type": "StatusBadge",
            "id": "safe.controller",
            "labelKey": "controller.status.label",
            "state": {
              "state": "controller.status",
              "format": "status"
            }
          },
          {
            "type": "StatusBadge",
            "id": "safe.sync",
            "labelKey": "transport.sync.label",
            "state": {
              "state": "transport.syncState",
              "format": "status"
            }
          },
          {
            "type": "StatusBadge",
            "id": "safe.safety",
            "labelKey": "safety.status.label",
            "state": {
              "state": "safety.summary",
              "format": "status"
            }
          }
        ]
      },
      {
        "type": "NativeComponent",
        "id": "safe.activeLayers",
        "componentType": "ember.activeLayers",
        "minimumVersion": 1,
        "variant": "safe",
        "readOnly": true,
        "flexGrow": 1,
        "minimumHeight": 120,
        "properties": {
          "showProgress": true,
          "showOverrideCount": true,
          "showLastFault": true
        }
      },
      {
        "type": "Row",
        "id": "safe.adapterActions",
        "gap": 8,
        "wrap": true,
        "children": [
          {
            "type": "Button",
            "id": "safe.reconnectDj",
            "labelKey": "action.reconnectDj",
            "on": {
              "command": "connection.os2l.reconnect",
              "event": "press"
            }
          },
          {
            "type": "Button",
            "id": "safe.openDiagnostics",
            "labelKey": "action.openDiagnostics",
            "on": {
              "command": "view.panel.open",
              "arguments": {
                "panel": "diagnostics"
              },
              "event": "press"
            }
          },
          {
            "type": "Button",
            "id": "safe.loadDefaultSkin",
            "labelKey": "action.loadDefaultSkin",
            "on": {
              "command": "view.skin.select",
              "arguments": {
                "skinId": "com.emberlights.skin.default"
              },
              "event": "press"
            }
          }
        ]
      },
      {
        "type": "Separator",
        "id": "safe.actionSeparator",
        "orientation": "horizontal"
      },
      {
        "type": "Grid",
        "id": "safe.primaryActions",
        "columns": 5,
        "rowGap": 8,
        "columnGap": 8,
        "children": [
          {
            "type": "Button",
            "id": "safe.stop",
            "labelKey": "action.stopShow",
            "danger": true,
            "on": {
              "command": "show.stop",
              "event": "press"
            },
            "accessibility": {
              "role": "button",
              "nameKey": "action.stopShow"
            }
          },
          {
            "type": "Toggle",
            "id": "safe.workLight",
            "labelKey": "action.workLight",
            "state": {
              "state": "output.workLight",
              "format": "boolean"
            },
            "on": {
              "command": "output.workLight.toggle",
              "event": "press"
            }
          },
          {
            "type": "Button",
            "id": "safe.releaseAll",
            "labelKey": "action.releaseAllOverrides",
            "on": {
              "command": "override.releaseAll",
              "event": "press"
            }
          },
          {
            "type": "Button",
            "id": "safe.quit",
            "labelKey": "action.quitSafely",
            "on": {
              "command": "app.quit.request",
              "event": "press"
            }
          },
          {
            "type": "Button",
            "id": "safe.blackout",
            "labelKey": "action.blackout",
            "danger": true,
            "emergency": true,
            "state": {
              "state": "output.blackout",
              "format": "boolean"
            },
            "on": {
              "command": "output.blackout.toggle",
              "event": "press"
            },
            "accessibility": {
              "role": "button",
              "nameKey": "action.blackout"
            }
          }
        ]
      }
    ]
  }
}
