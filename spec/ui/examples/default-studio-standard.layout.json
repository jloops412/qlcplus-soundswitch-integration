{
  "schemaVersion": 1,
  "workspace": "studio",
  "variant": "standard",
  "metadata": {
    "descriptionKey": "skin.default.studio.standard.description",
    "defaultFocus": "default.studio.assetBrowser",
    "minimumWidth": 1440,
    "minimumHeight": 800
  },
  "root": {
    "type": "Column",
    "id": "default.studio.root",
    "gap": 4,
    "children": [
      {
        "type": "Row",
        "id": "default.studio.chrome",
        "styleClass": ["studioChrome"],
        "padding": 8,
        "gap": 8,
        "align": "center",
        "children": [
          {
            "type": "Label",
            "id": "default.studio.brand",
            "labelKey": "app.name",
            "accessibility": { "role": "heading", "nameKey": "app.name" }
          },
          {
            "type": "Label",
            "id": "default.studio.project",
            "labelKey": "project.active.label",
            "value": { "state": "project.name", "format": "plain" }
          },
          {
            "type": "StatusBadge",
            "id": "default.studio.saveState",
            "labelKey": "project.saveState.label",
            "state": { "state": "project.saveState", "format": "status" }
          },
          {
            "type": "Label",
            "id": "default.studio.venue",
            "labelKey": "venue.active.label",
            "value": { "state": "project.activeVenue.name", "format": "plain" }
          },
          {
            "type": "Button",
            "id": "default.studio.validate",
            "labelKey": "action.validateProject",
            "on": { "command": "project.validate", "event": "press" }
          },
          {
            "type": "StatusBadge",
            "id": "default.studio.validation",
            "labelKey": "project.validation.label",
            "state": { "state": "project.validation.summary", "format": "status" },
            "on": {
              "command": "view.panel.open",
              "arguments": { "panel": "validation" },
              "event": "press"
            }
          },
          {
            "type": "Spacer",
            "id": "default.studio.chromeSpacer",
            "flexGrow": 1
          },
          {
            "type": "StatusBadge",
            "id": "default.studio.dj",
            "labelKey": "connection.dj.label",
            "state": { "state": "connection.dj.status", "format": "status" }
          },
          {
            "type": "StatusBadge",
            "id": "default.studio.outputs",
            "labelKey": "output.summary.label",
            "state": { "state": "output.summary.status", "format": "status" }
          },
          {
            "type": "Button",
            "id": "default.studio.commandExplorer",
            "labelKey": "action.commandExplorer",
            "on": { "command": "view.commandExplorer.open", "event": "press" }
          },
          {
            "type": "Button",
            "id": "default.studio.openLive",
            "labelKey": "action.openLive",
            "on": {
              "command": "workspace.open",
              "arguments": { "workspace": "live" },
              "event": "press"
            }
          }
        ]
      },
      {
        "type": "SplitPane",
        "id": "default.studio.mainSplit",
        "orientation": "horizontal",
        "ratios": [0.20, 0.58, 0.22],
        "persistenceKey": "default.studio.mainSplit",
        "flexGrow": 1,
        "children": [
          {
            "type": "Panel",
            "id": "default.studio.libraryPanel",
            "titleKey": "studio.library.title",
            "padding": 8,
            "children": [
              {
                "type": "NativeComponent",
                "id": "default.studio.assetBrowser",
                "componentType": "ember.assetBrowser",
                "minimumVersion": 1,
                "variant": "default-library",
                "properties": {
                  "assetKinds": ["music", "autoloop", "staticLook", "trackScript", "palette", "position", "attribute", "effect", "fixtureProfile", "group", "migration"],
                  "showSearch": true,
                  "showFilters": true,
                  "showFavorites": true,
                  "showProvenance": true
                }
              }
            ]
          },
          {
            "type": "Column",
            "id": "default.studio.center",
            "gap": 4,
            "children": [
              {
                "type": "Tabs",
                "id": "default.studio.canvasTabs",
                "selectionState": "view.studio.canvas",
                "placement": "top",
                "flexGrow": 1,
                "children": [
                  {
                    "type": "Panel",
                    "id": "default.studio.canvas.timeline",
                    "titleKey": "studio.canvas.timeline",
                    "children": [
                      {
                        "type": "SplitPane",
                        "id": "default.studio.timelineSplit",
                        "orientation": "horizontal",
                        "ratios": [0.24, 0.76],
                        "persistenceKey": "default.studio.timelineSplit",
                        "children": [
                          {
                            "type": "NativeComponent",
                            "id": "default.studio.trackHierarchy",
                            "componentType": "ember.trackHierarchy",
                            "minimumVersion": 1,
                            "variant": "default",
                            "properties": {
                              "showMaster": true,
                              "showGroups": true,
                              "showFixtures": true,
                              "showMuteSolo": true,
                              "showValidation": true
                            }
                          },
                          {
                            "type": "NativeComponent",
                            "id": "default.studio.timeline",
                            "componentType": "ember.timeline",
                            "minimumVersion": 1,
                            "variant": "default",
                            "properties": {
                              "showRuler": true,
                              "showGrid": true,
                              "showPlayhead": true,
                              "showLoopRange": true,
                              "showValidation": true
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Panel",
                    "id": "default.studio.canvas.autoloops",
                    "titleKey": "studio.canvas.autoloops",
                    "children": [
                      {
                        "type": "SplitPane",
                        "id": "default.studio.autoloopSplit",
                        "orientation": "horizontal",
                        "ratios": [0.42, 0.58],
                        "children": [
                          {
                            "type": "NativeComponent",
                            "id": "default.studio.autoloopMatrix",
                            "componentType": "ember.autoloopMatrix",
                            "minimumVersion": 1,
                            "variant": "default-studio",
                            "properties": {
                              "mode": "studio",
                              "bankWindowSize": 4,
                              "slotsPerBank": 32,
                              "showEmptySlots": true,
                              "showSlotNumbers": true,
                              "allowDrag": true,
                              "allowContextMenu": true
                            }
                          },
                          {
                            "type": "NativeComponent",
                            "id": "default.studio.autoloopEditor",
                            "componentType": "ember.autoloopEditor",
                            "minimumVersion": 1,
                            "variant": "default"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Panel",
                    "id": "default.studio.canvas.staticLooks",
                    "titleKey": "studio.canvas.staticLooks",
                    "children": [
                      {
                        "type": "SplitPane",
                        "id": "default.studio.lookSplit",
                        "orientation": "horizontal",
                        "ratios": [0.32, 0.68],
                        "children": [
                          {
                            "type": "NativeComponent",
                            "id": "default.studio.lookMatrix",
                            "componentType": "ember.staticLookMatrix",
                            "minimumVersion": 1,
                            "variant": "default-studio",
                            "properties": {
                              "showSearch": true,
                              "showCategories": true,
                              "showClear": false
                            }
                          },
                          {
                            "type": "NativeComponent",
                            "id": "default.studio.lookEditor",
                            "componentType": "ember.staticLookEditor",
                            "minimumVersion": 1,
                            "variant": "default",
                            "properties": {
                              "showOwnership": true,
                              "ownershipModes": ["RELEASE", "SET", "FORCE_ZERO"],
                              "showPreview": true
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Panel",
                    "id": "default.studio.canvas.venuePatch",
                    "titleKey": "studio.canvas.venuePatch",
                    "children": [
                      {
                        "type": "NativeComponent",
                        "id": "default.studio.venuePatch",
                        "componentType": "ember.venuePatchView",
                        "minimumVersion": 1,
                        "variant": "split",
                        "properties": {
                          "showUniverseChart": true,
                          "showSpatial": true,
                          "showRoles": true,
                          "showGroups": true,
                          "showValidation": true
                        }
                      }
                    ]
                  },
                  {
                    "type": "Panel",
                    "id": "default.studio.canvas.mapping",
                    "titleKey": "studio.canvas.mapping",
                    "children": [
                      {
                        "type": "NativeComponent",
                        "id": "default.studio.mappingEditor",
                        "componentType": "ember.mappingEditor",
                        "minimumVersion": 1,
                        "variant": "default"
                      }
                    ]
                  },
                  {
                    "type": "Panel",
                    "id": "default.studio.canvas.migration",
                    "titleKey": "studio.canvas.migration",
                    "children": [
                      {
                        "type": "NativeComponent",
                        "id": "default.studio.migrationReview",
                        "componentType": "ember.migrationReview",
                        "minimumVersion": 1,
                        "variant": "default"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "NativeComponent",
                "id": "default.studio.waveform",
                "componentType": "ember.waveformBeatgrid",
                "minimumVersion": 1,
                "variant": "default",
                "minimumHeight": 132,
                "properties": {
                  "showWaveform": true,
                  "showBeatgrid": true,
                  "showPhrases": true,
                  "showTransport": true,
                  "synchronizeTimelineViewport": true
                }
              }
            ]
          },
          {
            "type": "Panel",
            "id": "default.studio.inspectorPanel",
            "titleKey": "studio.inspector.title",
            "padding": 8,
            "children": [
              {
                "type": "NativeComponent",
                "id": "default.studio.inspector",
                "componentType": "ember.inspector",
                "minimumVersion": 1,
                "variant": "default",
                "properties": {
                  "showValidation": true,
                  "showProvenance": true,
                  "showScope": true,
                  "showCommandIntrospection": true,
                  "showLearnMidi": true
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Row",
        "id": "default.studio.transportBar",
        "styleClass": ["studioTransport"],
        "padding": 6,
        "gap": 6,
        "align": "center",
        "children": [
          {
            "type": "Button",
            "id": "default.studio.transportPlay",
            "labelKey": "transport.play",
            "on": { "command": "timeline.play", "event": "press" }
          },
          {
            "type": "Button",
            "id": "default.studio.transportPause",
            "labelKey": "transport.pause",
            "on": { "command": "timeline.pause", "event": "press" }
          },
          {
            "type": "Button",
            "id": "default.studio.transportStop",
            "labelKey": "transport.stop",
            "on": { "command": "timeline.stop", "event": "press" }
          },
          {
            "type": "Label",
            "id": "default.studio.transportBpm",
            "labelKey": "transport.bpm.label",
            "value": { "state": "transport.bpm", "format": "bpm" }
          },
          {
            "type": "Spacer",
            "id": "default.studio.transportSpacer",
            "flexGrow": 1
          },
          {
            "type": "Button",
            "id": "default.studio.connections",
            "labelKey": "action.openConnections",
            "on": {
              "command": "view.panel.open",
              "arguments": { "panel": "connections" },
              "event": "press"
            }
          },
          {
            "type": "Button",
            "id": "default.studio.history",
            "labelKey": "action.openHistory",
            "on": {
              "command": "view.panel.open",
              "arguments": { "panel": "history" },
              "event": "press"
            }
          },
          {
            "type": "Button",
            "id": "default.studio.diagnostics",
            "labelKey": "action.openDiagnostics",
            "on": {
              "command": "view.panel.open",
              "arguments": { "panel": "diagnostics" },
              "event": "press"
            }
          }
        ]
      }
    ]
  }
}
