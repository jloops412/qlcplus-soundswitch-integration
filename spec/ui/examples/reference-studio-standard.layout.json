{
  "schemaVersion": 1,
  "workspace": "studio",
  "variant": "standard",
  "metadata": {
    "descriptionKey": "skin.reference.studio.standard.description",
    "defaultFocus": "reference.studio.musicLibrary",
    "minimumWidth": 1440,
    "minimumHeight": 800
  },
  "root": {
    "type": "Column",
    "id": "reference.studio.root",
    "gap": 2,
    "children": [
      {
        "type": "Row",
        "id": "reference.studio.menuToolbar",
        "styleClass": ["referenceChrome", "referenceToolbar"],
        "padding": 4,
        "gap": 4,
        "align": "center",
        "children": [
          {
            "type": "MenuButton",
            "id": "reference.studio.fileMenu",
            "labelKey": "menu.file"
          },
          {
            "type": "MenuButton",
            "id": "reference.studio.editMenu",
            "labelKey": "menu.edit"
          },
          {
            "type": "MenuButton",
            "id": "reference.studio.viewMenu",
            "labelKey": "menu.view"
          },
          {
            "type": "Separator",
            "id": "reference.studio.toolbarSeparator1",
            "orientation": "vertical"
          },
          {
            "type": "Button",
            "id": "reference.studio.save",
            "labelKey": "action.saveProject",
            "on": { "command": "project.save", "event": "press" }
          },
          {
            "type": "Button",
            "id": "reference.studio.undo",
            "labelKey": "action.undo",
            "on": { "command": "undo.perform", "event": "press" }
          },
          {
            "type": "Button",
            "id": "reference.studio.redo",
            "labelKey": "action.redo",
            "on": { "command": "redo.perform", "event": "press" }
          },
          {
            "type": "Button",
            "id": "reference.studio.validate",
            "labelKey": "action.validateProject",
            "on": { "command": "project.validate", "event": "press" }
          },
          {
            "type": "Spacer",
            "id": "reference.studio.toolbarSpacer",
            "flexGrow": 1
          },
          {
            "type": "StatusBadge",
            "id": "reference.studio.saveState",
            "labelKey": "project.saveState.label",
            "state": { "state": "project.saveState", "format": "status" }
          },
          {
            "type": "StatusBadge",
            "id": "reference.studio.djStatus",
            "labelKey": "connection.dj.label",
            "state": { "state": "connection.dj.status", "format": "status" }
          },
          {
            "type": "StatusBadge",
            "id": "reference.studio.hardwareStatus",
            "labelKey": "connection.hardware.label",
            "state": { "state": "output.summary.status", "format": "status" }
          },
          {
            "type": "Button",
            "id": "reference.studio.openLive",
            "labelKey": "action.openLive",
            "on": {
              "command": "workspace.open",
              "arguments": { "workspace": "live" },
              "event": "press"
            }
          }
        ]
      },
      {
        "type": "Row",
        "id": "reference.studio.venueTabs",
        "styleClass": ["referenceVenueTabs"],
        "padding": 4,
        "gap": 4,
        "align": "center",
        "children": [
          {
            "type": "SegmentedControl",
            "id": "reference.studio.venueSelector",
            "selectionState": "project.activeVenue.id",
            "placement": "top",
            "flexGrow": 1,
            "children": [
              {
                "type": "Panel",
                "id": "reference.studio.venuePlaceholder",
                "titleKey": "venue.active.label",
                "children": [
                  {
                    "type": "Label",
                    "id": "reference.studio.venueName",
                    "labelKey": "venue.active.label",
                    "value": { "state": "project.activeVenue.name", "format": "plain" }
                  }
                ]
              }
            ]
          },
          {
            "type": "Button",
            "id": "reference.studio.addVenue",
            "labelKey": "action.addVenue",
            "on": { "command": "venue.create", "event": "press" }
          },
          {
            "type": "Button",
            "id": "reference.studio.connections",
            "labelKey": "action.openConnections",
            "on": {
              "command": "view.panel.open",
              "arguments": { "panel": "connections" },
              "event": "press"
            }
          }
        ]
      },
      {
        "type": "SplitPane",
        "id": "reference.studio.mainSplit",
        "orientation": "horizontal",
        "ratios": [0.20, 0.60, 0.20],
        "persistenceKey": "reference.studio.mainSplit",
        "flexGrow": 1,
        "children": [
          {
            "type": "SplitPane",
            "id": "reference.studio.leftSplit",
            "orientation": "vertical",
            "ratios": [0.58, 0.42],
            "persistenceKey": "reference.studio.leftSplit",
            "children": [
              {
                "type": "Panel",
                "id": "reference.studio.musicPanel",
                "titleKey": "reference.library.music",
                "children": [
                  {
                    "type": "NativeComponent",
                    "id": "reference.studio.musicLibrary",
                    "componentType": "ember.assetBrowser",
                    "minimumVersion": 1,
                    "variant": "reference-music",
                    "properties": {
                      "assetKinds": ["music", "trackScript"],
                      "showSearch": true,
                      "showFilters": true,
                      "showFavorites": false,
                      "showProvenance": false
                    }
                  }
                ]
              },
              {
                "type": "Tabs",
                "id": "reference.studio.effectTabs",
                "selectionState": "view.reference.studio.libraryPage",
                "placement": "top",
                "children": [
                  {
                    "type": "Panel",
                    "id": "reference.studio.effectPage.effects",
                    "titleKey": "reference.library.effects",
                    "children": [
                      {
                        "type": "NativeComponent",
                        "id": "reference.studio.effectLibrary",
                        "componentType": "ember.assetBrowser",
                        "minimumVersion": 1,
                        "variant": "reference-effects",
                        "properties": {
                          "assetKinds": ["effect", "palette", "position", "attribute"],
                          "showSearch": true,
                          "showFilters": false
                        }
                      }
                    ]
                  },
                  {
                    "type": "Panel",
                    "id": "reference.studio.effectPage.autoloops",
                    "titleKey": "reference.library.autoloops",
                    "children": [
                      {
                        "type": "NativeComponent",
                        "id": "reference.studio.autoloopLibrary",
                        "componentType": "ember.assetBrowser",
                        "minimumVersion": 1,
                        "variant": "reference-autoloops",
                        "properties": {
                          "assetKinds": ["autoloop"],
                          "showSearch": true
                        }
                      }
                    ]
                  },
                  {
                    "type": "Panel",
                    "id": "reference.studio.effectPage.looks",
                    "titleKey": "reference.library.staticLooks",
                    "children": [
                      {
                        "type": "NativeComponent",
                        "id": "reference.studio.lookLibrary",
                        "componentType": "ember.assetBrowser",
                        "minimumVersion": 1,
                        "variant": "reference-looks",
                        "properties": {
                          "assetKinds": ["staticLook"],
                          "showSearch": true
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "Column",
            "id": "reference.studio.center",
            "gap": 2,
            "children": [
              {
                "type": "SplitPane",
                "id": "reference.studio.timelineSplit",
                "orientation": "horizontal",
                "ratios": [0.24, 0.76],
                "persistenceKey": "reference.studio.timelineSplit",
                "flexGrow": 1,
                "children": [
                  {
                    "type": "NativeComponent",
                    "id": "reference.studio.trackHierarchy",
                    "componentType": "ember.trackHierarchy",
                    "minimumVersion": 1,
                    "variant": "soundswitch-reference",
                    "properties": {
                      "showMaster": true,
                      "showGroups": true,
                      "showFixtures": true,
                      "showMuteSolo": true,
                      "showCollapse": true,
                      "showScopeIcons": true
                    }
                  },
                  {
                    "type": "NativeComponent",
                    "id": "reference.studio.timeline",
                    "componentType": "ember.timeline",
                    "minimumVersion": 1,
                    "variant": "soundswitch-reference",
                    "properties": {
                      "showRuler": true,
                      "showGrid": true,
                      "showPlayhead": true,
                      "showLoopRange": true,
                      "showCueLabels": true,
                      "showPositionMarkers": true,
                      "showAttributeMarkers": true
                    }
                  }
                ]
              },
              {
                "type": "NativeComponent",
                "id": "reference.studio.waveform",
                "componentType": "ember.waveformBeatgrid",
                "minimumVersion": 1,
                "variant": "soundswitch-reference",
                "minimumHeight": 120,
                "properties": {
                  "showWaveform": true,
                  "showBeatgrid": true,
                  "showPhrases": true,
                  "showTransport": true,
                  "synchronizeTimelineViewport": true
                }
              },
              {
                "type": "Row",
                "id": "reference.studio.transport",
                "styleClass": ["referenceTransport"],
                "padding": 4,
                "gap": 4,
                "align": "center",
                "children": [
                  {
                    "type": "Button",
                    "id": "reference.studio.play",
                    "labelKey": "transport.play",
                    "on": { "command": "timeline.play", "event": "press" }
                  },
                  {
                    "type": "Button",
                    "id": "reference.studio.pause",
                    "labelKey": "transport.pause",
                    "on": { "command": "timeline.pause", "event": "press" }
                  },
                  {
                    "type": "Button",
                    "id": "reference.studio.stop",
                    "labelKey": "transport.stop",
                    "on": { "command": "timeline.stop", "event": "press" }
                  },
                  {
                    "type": "Label",
                    "id": "reference.studio.bpm",
                    "labelKey": "transport.bpm.label",
                    "value": { "state": "transport.bpm", "format": "bpm" }
                  },
                  {
                    "type": "Spacer",
                    "id": "reference.studio.transportSpacer",
                    "flexGrow": 1
                  },
                  {
                    "type": "Button",
                    "id": "reference.studio.zoomOut",
                    "labelKey": "timeline.zoomOut",
                    "on": { "command": "timeline.zoom.out", "event": "press" }
                  },
                  {
                    "type": "Button",
                    "id": "reference.studio.zoomIn",
                    "labelKey": "timeline.zoomIn",
                    "on": { "command": "timeline.zoom.in", "event": "press" }
                  }
                ]
              }
            ]
          },
          {
            "type": "Tabs",
            "id": "reference.studio.rightTabs",
            "selectionState": "view.reference.studio.rightPage",
            "placement": "top",
            "children": [
              {
                "type": "Panel",
                "id": "reference.studio.right.inspector",
                "titleKey": "studio.inspector.title",
                "children": [
                  {
                    "type": "NativeComponent",
                    "id": "reference.studio.inspector",
                    "componentType": "ember.inspector",
                    "minimumVersion": 1,
                    "variant": "soundswitch-reference",
                    "properties": {
                      "showValidation": true,
                      "showProvenance": false,
                      "showScope": true,
                      "showCommandIntrospection": false,
                      "showLearnMidi": true
                    }
                  }
                ]
              },
              {
                "type": "Panel",
                "id": "reference.studio.right.fixtures",
                "titleKey": "reference.library.fixtures",
                "children": [
                  {
                    "type": "NativeComponent",
                    "id": "reference.studio.fixtureBrowser",
                    "componentType": "ember.fixtureProfileBrowser",
                    "minimumVersion": 1,
                    "variant": "soundswitch-reference",
                    "properties": {
                      "showSearch": true,
                      "showManufacturer": true,
                      "showModel": true,
                      "showMode": true,
                      "allowDragToVenue": true
                    }
                  }
                ]
              },
              {
                "type": "Panel",
                "id": "reference.studio.right.patch",
                "titleKey": "reference.patch.title",
                "children": [
                  {
                    "type": "NativeComponent",
                    "id": "reference.studio.patchView",
                    "componentType": "ember.venuePatchView",
                    "minimumVersion": 1,
                    "variant": "universeChart",
                    "properties": {
                      "showUniverseChart": true,
                      "showSpatial": false,
                      "showRoles": false,
                      "showGroups": true,
                      "showValidation": true
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
