{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emberlights.dev/schema/ui/binding-definition-v0.json",
  "title": "EmberLights Binding Definition v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "since",
    "source",
    "command",
    "behavior",
    "enabled"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "since": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "command": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$"
    },
    "arguments": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "$ref": "#/$defs/argumentValue"
      }
    },
    "behavior": {
      "enum": [
        "trigger",
        "momentary",
        "toggle",
        "latch",
        "absolute",
        "relative",
        "selection"
      ]
    },
    "transform": {
      "$ref": "#/$defs/transform"
    },
    "feedback": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/feedback" }
      ]
    },
    "condition": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 2048 }
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000,
      "default": 0
    },
    "enabled": {
      "type": "boolean"
    },
    "persistenceScope": {
      "enum": [
        "appLocal",
        "controllerProfile",
        "projectAuthored",
        "skinOverlay"
      ],
      "default": "controllerProfile"
    },
    "deprecated": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "skinControl",
            "keyboard",
            "midi",
            "hid",
            "djCommand",
            "external",
            "test"
          ]
        },
        "controlId": {
          "type": "string",
          "maxLength": 128
        },
        "deviceId": {
          "type": "string",
          "maxLength": 160
        },
        "portId": {
          "type": "string",
          "maxLength": 160
        },
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "messageType": {
          "enum": [
            "note",
            "cc",
            "pitch",
            "program",
            "aftertouch",
            "relativeEncoder",
            "key",
            "pointer",
            "touch",
            "custom"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "modifier": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "enum": ["shift", "control", "alt", "meta", "layer1", "layer2", "layer3", "layer4"]
          }
        },
        "event": {
          "enum": [
            "press",
            "release",
            "change",
            "doublePress",
            "longPress",
            "repeat",
            "focus",
            "blur"
          ]
        }
      }
    },
    "argumentValue": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "string", "maxLength": 1024 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["context"],
          "properties": {
            "context": {
              "type": "string",
              "maxLength": 160
            }
          }
        }
      ]
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputMinimum": { "type": "number" },
        "inputMaximum": { "type": "number" },
        "outputMinimum": { "type": "number" },
        "outputMaximum": { "type": "number" },
        "invert": { "type": "boolean", "default": false },
        "curve": {
          "enum": ["linear", "logarithmic", "exponential", "sCurve", "customPoints"],
          "default": "linear"
        },
        "customPoints": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "relativeMode": {
          "enum": ["none", "twosComplement", "binaryOffset", "signMagnitude", "incrementDecrement"]
        },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "deadZone": { "type": "number", "minimum": 0, "maximum": 1 },
        "softTakeover": { "type": "boolean", "default": false },
        "pickupTolerance": { "type": "number", "minimum": 0, "maximum": 1 },
        "rateLimitHz": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "format": {
          "enum": [
            "boolean",
            "value",
            "range",
            "color",
            "text",
            "enumMap"
          ],
          "default": "value"
        },
        "onValue": {},
        "offValue": {},
        "enumMap": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {}
        },
        "rateLimitHz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "echoSuppressionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      }
    }
  }
}
