{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emberlights.dev/schema/ui/skin-manifest-v0.json",
  "title": "EmberLights Skin Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "nameKey",
    "version",
    "author",
    "minimumAppVersion",
    "workspaces",
    "variants",
    "fallbackVariant",
    "entrypoints",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$"
    },
    "nameKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "descriptionKey": {
      "type": "string",
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "homepage": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "uri", "maxLength": 512 }
      ]
    },
    "license": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 128 }
      ]
    },
    "minimumAppVersion": {
      "type": "string",
      "maxLength": 64
    },
    "maximumAppVersion": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 64 }
      ]
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["projectHub", "studio", "live", "safe"]
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "fallbackVariant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^layouts/[A-Za-z0-9._/-]+\\.json$"
      }
    },
    "theme": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^styles/[A-Za-z0-9._/-]+\\.json$",
      "default": "styles/theme.json"
    },
    "defaultBindings": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "maxLength": 240,
          "pattern": "^bindings/[A-Za-z0-9._/-]+\\.json$"
        }
      ]
    },
    "defaultLocale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "default": "en-US"
    },
    "locales": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      }
    },
    "requiredCommands": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128
      }
    },
    "requiredStates": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 160
      }
    },
    "requiredComponents": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/componentRequirement"
      }
    },
    "optionalCapabilities": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "previews": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 240,
        "pattern": "^assets/[A-Za-z0-9._/-]+\\.(png|webp)$"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": ["bundled", "local", "imported"]
        },
        "createdWith": {
          "type": "string",
          "maxLength": 128
        },
        "basedOn": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 128 }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "fallbackVariant": {
          "enum": [
            "compact",
            "standard",
            "wide",
            "touch-live",
            "safe"
          ]
        }
      }
    }
  ],
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace", "minimumWidth", "minimumHeight", "inputMode"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
        },
        "workspace": {
          "enum": ["projectHub", "studio", "live", "safe"]
        },
        "minimumWidth": {
          "type": "integer",
          "minimum": 320,
          "maximum": 16384
        },
        "minimumHeight": {
          "type": "integer",
          "minimum": 240,
          "maximum": 16384
        },
        "maximumWidth": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 320, "maximum": 16384 }
          ]
        },
        "maximumHeight": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 240, "maximum": 16384 }
          ]
        },
        "minimumScalePercent": {
          "type": "integer",
          "minimum": 50,
          "maximum": 400,
          "default": 100
        },
        "maximumScalePercent": {
          "type": "integer",
          "minimum": 50,
          "maximum": 400,
          "default": 400
        },
        "inputMode": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["mouseKeyboard", "touch", "hybrid"]
          }
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "default": 0
        }
      }
    },
    "componentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minimumVersion"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "minimumVersion": {
          "type": "integer",
          "minimum": 1
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^assets/[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": ["svg", "png", "webp", "otherStatic"]
        },
        "license": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 128 }
          ]
        },
        "source": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 512 }
          ]
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
