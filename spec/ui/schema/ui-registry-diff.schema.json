{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emberlights.dev/schema/ui/ui-registry-diff-v1.json",
  "title": "EmberLights UI Registry Compatibility Diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineDigest",
    "candidateDigest",
    "classification",
    "registries",
    "summary",
    "migrationAvailable",
    "manualActionRequired"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "baselineDigest": {"type": ["string", "null"]},
    "candidateDigest": {"type": ["string", "null"]},
    "classification": {"enum": ["unchanged", "compatibleAdditive", "compatibleWithDeprecations", "breaking"]},
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands", "states", "components", "capabilities", "values", "results", "interactions"
      ],
      "properties": {
        "commands": {"$ref": "#/$defs/registryDetail"},
        "states": {"$ref": "#/$defs/registryDetail"},
        "components": {"$ref": "#/$defs/registryDetail"},
        "capabilities": {"$ref": "#/$defs/registryDetail"},
        "values": {"$ref": "#/$defs/registryDetail"},
        "results": {"$ref": "#/$defs/registryDetail"},
        "interactions": {"$ref": "#/$defs/registryDetail"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "changedCompatible", "deprecated", "replacementAvailable", "changedBreaking", "removed", "unchanged"],
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "changedCompatible": {"type": "integer", "minimum": 0},
        "deprecated": {"type": "integer", "minimum": 0},
        "replacementAvailable": {"type": "integer", "minimum": 0},
        "changedBreaking": {"type": "integer", "minimum": 0},
        "removed": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0}
      }
    },
    "migrationAvailable": {"type": "boolean"},
    "manualActionRequired": {"type": "boolean"}
  },
  "$defs": {
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "registryDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added", "changedCompatible", "deprecated", "replacementAvailable",
        "changedBreaking", "removed", "unchanged"
      ],
      "properties": {
        "added": {"$ref": "#/$defs/idList"},
        "changedCompatible": {"$ref": "#/$defs/idList"},
        "deprecated": {"$ref": "#/$defs/idList"},
        "replacementAvailable": {"$ref": "#/$defs/idList"},
        "changedBreaking": {"$ref": "#/$defs/idList"},
        "removed": {"$ref": "#/$defs/idList"},
        "unchanged": {"$ref": "#/$defs/idList"}
      }
    }
  }
}
