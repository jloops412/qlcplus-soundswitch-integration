{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emberlights.dev/schema/ui/controller-profile-v1.json",
  "title": "EmberLights Controller Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "active",
    "deviceMatchers",
    "qualification",
    "controls"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "active": { "type": "boolean" },
    "deviceMatchers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "$ref": "#/$defs/deviceMatcher" },
        "output": { "$ref": "#/$defs/deviceMatcher" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "inputPacketsCaptured", "feedbackPacketsCaptured", "notes"],
      "properties": {
        "state": {
          "enum": ["captureRequired", "inputQualified", "fullyQualified", "rejected"]
        },
        "inputPacketsCaptured": { "type": "boolean" },
        "feedbackPacketsCaptured": { "type": "boolean" },
        "qualifiedAt": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "qualifiedBy": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 160 }
          ]
        },
        "notes": { "type": "string", "maxLength": 4096 }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url"],
        "properties": {
          "kind": { "enum": ["officialBehavior", "packetCapture", "physicalTest"] },
          "url": { "type": "string", "format": "uri", "maxLength": 1024 },
          "note": { "type": "string", "maxLength": 1024 }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qualification": {
            "type": "object",
            "properties": { "state": { "const": "captureRequired" } },
            "required": ["state"]
          }
        }
      },
      "then": {
        "properties": { "active": { "const": false } }
      }
    },
    {
      "if": { "properties": { "active": { "const": true } } },
      "then": {
        "properties": {
          "qualification": {
            "type": "object",
            "properties": { "state": { "const": "fullyQualified" } },
            "required": ["state"]
          }
        }
      }
    }
  ],
  "$defs": {
    "deviceMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nameContains"],
      "properties": {
        "nameContains": { "type": "string", "minLength": 1, "maxLength": 160 },
        "manufacturerId": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        },
        "productId": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        }
      }
    },
    "messagePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "channel", "number"],
      "properties": {
        "type": { "enum": ["noteOn", "noteOff", "controlChange", "pitchBend"] },
        "channel": { "type": "integer", "minimum": 0, "maximum": 15 },
        "number": { "type": "integer", "minimum": 0, "maximum": 127 },
        "pressValue": { "type": "integer", "minimum": 0, "maximum": 16383 },
        "releaseValue": { "type": "integer", "minimum": 0, "maximum": 16383 }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "zone",
        "interaction",
        "command",
        "implementation",
        "input",
        "feedback"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z0-9_-]+)+$",
          "maxLength": 160
        },
        "zone": { "type": "string", "minLength": 1, "maxLength": 80 },
        "interaction": {
          "enum": ["momentary", "toggle", "absolute", "relative", "selection", "chord"]
        },
        "command": { "type": "string", "minLength": 3, "maxLength": 160 },
        "arguments": { "type": "object", "maxProperties": 16, "additionalProperties": true },
        "implementation": { "enum": ["ready", "engineGap", "captureOnly"] },
        "input": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/messagePattern" }]
        },
        "feedback": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/messagePattern" }
        },
        "notes": { "type": "string", "maxLength": 1024 }
      }
    }
  }
}
