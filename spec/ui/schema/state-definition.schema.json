{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emberlights.dev/schema/ui/state-definition-v0.json",
  "title": "EmberLights State Definition v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "since",
    "labelKey",
    "descriptionKey",
    "value",
    "scope",
    "updateClass",
    "authority",
    "nullable",
    "deprecated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z0-9_\\[\\]-]+)+$"
    },
    "since": {
      "type": "integer",
      "minimum": 1
    },
    "labelKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "descriptionKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "category": {
      "type": "string",
      "maxLength": 80
    },
    "value": {
      "$ref": "#/$defs/valueDefinition"
    },
    "scope": {
      "enum": [
        "appLocal",
        "projectDocument",
        "activePackage",
        "runner",
        "connection",
        "controller",
        "output",
        "safety",
        "viewLocal",
        "diagnostic"
      ]
    },
    "updateClass": {
      "enum": [
        "static",
        "onChange",
        "slow",
        "health",
        "transport",
        "progress",
        "onDemand"
      ]
    },
    "maximumPublishHz": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "authority": {
      "enum": [
        "application",
        "projectDocument",
        "compiler",
        "runnerScheduler",
        "runnerService",
        "adapter",
        "bindingService",
        "uiViewModel",
        "diagnosticService"
      ]
    },
    "snapshotGroup": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 80 }
      ]
    },
    "nullable": {
      "type": "boolean"
    },
    "default": {},
    "format": {
      "oneOf": [
        { "type": "null" },
        {
          "enum": [
            "plain",
            "percent",
            "bpm",
            "milliseconds",
            "seconds",
            "beats",
            "dmxAddress",
            "universe",
            "timestamp",
            "duration",
            "hex",
            "endpoint",
            "path",
            "errorCode"
          ]
        }
      ]
    },
    "unit": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 32 }
      ]
    },
    "accessibleValue": {
      "enum": [
        "raw",
        "formatted",
        "labelAndFormatted",
        "custom"
      ],
      "default": "formatted"
    },
    "privacy": {
      "enum": [
        "publicUi",
        "ownerUi",
        "diagnostic",
        "sensitiveLocal"
      ],
      "default": "publicUi"
    },
    "persisted": {
      "type": "boolean",
      "default": false
    },
    "deprecated": {
      "type": "boolean"
    },
    "replacement": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        }
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "updateClass": {
            "enum": ["slow", "health", "transport", "progress"]
          }
        }
      },
      "then": {
        "required": ["maximumPublishHz"]
      }
    },
    {
      "if": {
        "properties": { "deprecated": { "const": true } }
      },
      "then": {
        "required": ["replacement"]
      }
    },
    {
      "if": {
        "properties": { "scope": { "const": "viewLocal" } }
      },
      "then": {
        "properties": {
          "authority": { "const": "uiViewModel" }
        }
      }
    },
    {
      "if": {
        "properties": { "authority": { "const": "runnerScheduler" } }
      },
      "then": {
        "properties": {
          "persisted": { "const": false }
        }
      }
    }
  ],
  "$defs": {
    "valueDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "enum",
            "id",
            "object",
            "array"
          ]
        },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "enumValues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": ["string", "integer"]
          }
        },
        "itemType": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "enum",
            "id",
            "object"
          ]
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "schemaRef": {
          "type": "string",
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": { "required": ["enumValues"] }
        },
        {
          "if": { "properties": { "type": { "const": "array" } } },
          "then": { "required": ["itemType", "maxItems"] }
        },
        {
          "if": { "properties": { "type": { "const": "object" } } },
          "then": { "required": ["schemaRef"] }
        }
      ]
    }
  }
}
