{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emberlights.dev/schema/ui/command-definition-v0.json",
  "title": "EmberLights Command Definition v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "since",
    "labelKey",
    "descriptionKey",
    "scope",
    "interaction",
    "realtimeClass",
    "parameters",
    "availability",
    "undoable",
    "persistenceScope",
    "deprecated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$"
    },
    "since": {
      "type": "integer",
      "minimum": 1
    },
    "labelKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "descriptionKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "category": {
      "type": "string",
      "maxLength": 80
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "app",
          "studio",
          "live",
          "keyboard",
          "midi",
          "controller",
          "external",
          "internal"
        ]
      }
    },
    "interaction": {
      "enum": [
        "trigger",
        "momentary",
        "toggle",
        "latch",
        "absolute",
        "relative",
        "selection",
        "transaction"
      ]
    },
    "realtimeClass": {
      "enum": [
        "emergency",
        "priorityLive",
        "runnerCommand",
        "studioMutation",
        "viewLocal",
        "blockingUtility"
      ]
    },
    "parameters": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "availability": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "maxLength": 2048 }
      ]
    },
    "safetyGate": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 128 }
      ]
    },
    "feedback": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 160
      }
    },
    "undoable": {
      "type": "boolean"
    },
    "undoGroup": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 80 }
      ]
    },
    "persistenceScope": {
      "enum": [
        "none",
        "appLocal",
        "projectAuthored",
        "liveTransient"
      ]
    },
    "requiresActiveProject": {
      "type": "boolean",
      "default": false
    },
    "requiresActivePackage": {
      "type": "boolean",
      "default": false
    },
    "requiresRunner": {
      "type": "boolean",
      "default": false
    },
    "repeatPolicy": {
      "enum": [
        "ignore",
        "allow",
        "coalesce",
        "rateLimit"
      ],
      "default": "ignore"
    },
    "rateLimitHz": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "deprecated": {
      "type": "boolean"
    },
    "replacement": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$"
        }
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "deprecated": { "const": true } }
      },
      "then": {
        "required": ["replacement"]
      }
    },
    {
      "if": {
        "properties": { "repeatPolicy": { "const": "rateLimit" } }
      },
      "then": {
        "required": ["rateLimitHz"]
      }
    },
    {
      "if": {
        "properties": { "realtimeClass": { "const": "emergency" } }
      },
      "then": {
        "properties": {
          "persistenceScope": { "const": "liveTransient" },
          "undoable": { "const": false }
        }
      }
    }
  ],
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "enum",
            "id",
            "array"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "enumValues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": ["string", "integer"]
          }
        },
        "itemType": {
          "enum": ["boolean", "integer", "number", "string", "id"]
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "default": {},
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "targetKind": {
          "type": "string",
          "maxLength": 80
        },
        "descriptionKey": {
          "type": "string",
          "maxLength": 160
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": { "required": ["enumValues"] }
        },
        {
          "if": { "properties": { "type": { "const": "array" } } },
          "then": { "required": ["itemType", "maxItems"] }
        }
      ]
    }
  }
}
