{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.emberlights.local/ui/ember-action.schema.json",
  "title": "EmberLights Ember Action",
  "description": "Versioned, typed, bounded action graph over registered EmberLights commands and state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "label",
    "compatibility",
    "parameters",
    "requires",
    "entryPoints",
    "nodes",
    "feedback"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/stableIdentifier"
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "label": {
      "$ref": "#/$defs/shortText"
    },
    "description": {
      "$ref": "#/$defs/longText"
    },
    "author": {
      "$ref": "#/$defs/shortText"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/memberIdentifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameterDefinition"
      }
    },
    "requires": {
      "$ref": "#/$defs/requirements"
    },
    "entryPoints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "onPress": {
          "$ref": "#/$defs/nodeReference"
        },
        "onRelease": {
          "$ref": "#/$defs/nodeReference"
        },
        "onValue": {
          "$ref": "#/$defs/nodeReference"
        },
        "onEncoderStep": {
          "$ref": "#/$defs/nodeReference"
        },
        "onLongPress": {
          "$ref": "#/$defs/nodeReference"
        },
        "onDoublePress": {
          "$ref": "#/$defs/nodeReference"
        },
        "onActivate": {
          "$ref": "#/$defs/nodeReference"
        },
        "onDeactivate": {
          "$ref": "#/$defs/nodeReference"
        }
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/nodeIdentifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "feedback": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/memberIdentifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/expression"
      }
    },
    "surfaceState": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/memberIdentifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/surfaceStateDefinition"
      }
    },
    "limits": {
      "$ref": "#/$defs/declaredLimits"
    },
    "localization": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "enum": [
            "visualGraph",
            "emberActionScript",
            "imported"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 32768
        },
        "sourceMap": {
          "$ref": "#/$defs/sourceMap"
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "stableIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "memberIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z_][A-Za-z0-9._-]*$"
    },
    "nodeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nodeReference": {
      "$ref": "#/$defs/nodeIdentifier"
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "versionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "longText": {
      "type": "string",
      "maxLength": 8192
    },
    "unitIdentifier": {
      "enum": [
        "normalized",
        "percent",
        "bpm",
        "beats",
        "bars",
        "seconds",
        "milliseconds",
        "degrees",
        "dmx8",
        "dmx16"
      ]
    },
    "portableSourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:virtual:[A-Za-z0-9._:/-]+|(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+)$"
    },
    "boundedScalar": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096
        }
      ]
    },
    "boundedJsonValueLevel0": {
      "$ref": "#/$defs/boundedScalar"
    },
    "boundedJsonValueLevel1": {
      "oneOf": [
        {
          "$ref": "#/$defs/boundedScalar"
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/boundedJsonValueLevel0"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/boundedJsonValueLevel0"
          }
        }
      ]
    },
    "boundedJsonValueLevel2": {
      "oneOf": [
        {
          "$ref": "#/$defs/boundedScalar"
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/boundedJsonValueLevel1"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/boundedJsonValueLevel1"
          }
        }
      ]
    },
    "boundedJsonValueLevel3": {
      "oneOf": [
        {
          "$ref": "#/$defs/boundedScalar"
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/boundedJsonValueLevel2"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/boundedJsonValueLevel2"
          }
        }
      ]
    },
    "boundedJsonValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/boundedScalar"
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/boundedJsonValueLevel3"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/boundedJsonValueLevel3"
          }
        }
      ]
    },
    "sourceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sources",
        "ranges"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sources": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/memberIdentifier"
              },
              "path": {
                "$ref": "#/$defs/portableSourceName"
              },
              "contentHash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "ranges": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/nodeIdentifier"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "start",
              "end"
            ],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/memberIdentifier"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "bundled",
            "local",
            "forked",
            "imported",
            "migrated"
          ]
        },
        "sourceId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "sourceVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "sourceHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "migrationAdapter": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "migrationStatus": {
          "enum": [
            "native",
            "exact",
            "translated",
            "approximated",
            "opaque",
            "unsupported",
            "conflicted"
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumAppVersion",
        "commandRegistry",
        "stateRegistry",
        "capabilityRegistry"
      ],
      "properties": {
        "minimumAppVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "maximumAppVersion": {
          "oneOf": [
            {
              "$ref": "#/$defs/semanticVersion"
            },
            {
              "type": "null"
            }
          ]
        },
        "commandRegistry": {
          "$ref": "#/$defs/versionRange"
        },
        "stateRegistry": {
          "$ref": "#/$defs/versionRange"
        },
        "componentRegistry": {
          "$ref": "#/$defs/versionRange"
        },
        "capabilityRegistry": {
          "$ref": "#/$defs/versionRange"
        },
        "bindingSchema": {
          "$ref": "#/$defs/versionRange"
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "states",
        "capabilities"
      ],
      "properties": {
        "commands": {
          "$ref": "#/$defs/identifierArray"
        },
        "states": {
          "$ref": "#/$defs/identifierArray"
        },
        "capabilities": {
          "$ref": "#/$defs/identifierArray"
        },
        "components": {
          "$ref": "#/$defs/identifierArray"
        },
        "actions": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "versionRange"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/stableIdentifier"
              },
              "versionRange": {
                "$ref": "#/$defs/versionRange"
              }
            }
          }
        },
        "projectTargets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter",
              "targetKind"
            ],
            "properties": {
              "parameter": {
                "$ref": "#/$defs/memberIdentifier"
              },
              "targetKind": {
                "$ref": "#/$defs/stableIdentifier"
              },
              "optional": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    },
    "identifierArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableIdentifier"
      }
    },
    "valueType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "enum",
            "string",
            "stableId",
            "semanticRole",
            "color",
            "duration",
            "object",
            "list",
            "result",
            "void"
          ]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/unitIdentifier"
        },
        "values": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "targetKind": {
          "$ref": "#/$defs/stableIdentifier"
        },
        "schemaRef": {
          "type": "string",
          "maxLength": 256
        },
        "itemType": {
          "$ref": "#/$defs/valueType"
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "values"
                ]
              },
              {
                "required": [
                  "schemaRef"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stableId"
              }
            }
          },
          "then": {
            "required": [
              "targetKind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "schemaRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "required": [
              "itemType",
              "maxItems"
            ]
          }
        }
      ]
    },
    "parameterDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valueType",
        "required"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/shortText"
        },
        "description": {
          "$ref": "#/$defs/longText"
        },
        "valueType": {
          "$ref": "#/$defs/valueType"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "$ref": "#/$defs/boundedJsonValue"
        },
        "picker": {
          "$ref": "#/$defs/stableIdentifier"
        }
      }
    },
    "surfaceStateDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valueType",
        "default",
        "reset"
      ],
      "properties": {
        "valueType": {
          "$ref": "#/$defs/valueType"
        },
        "default": {
          "$ref": "#/$defs/boundedJsonValue"
        },
        "reset": {
          "enum": [
            "invocation",
            "pageActivation",
            "skinActivation",
            "appRestart",
            "explicit"
          ]
        },
        "persistentScope": {
          "enum": [
            "none",
            "appLocal"
          ]
        }
      }
    },
    "valueReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "path"
      ],
      "properties": {
        "source": {
          "enum": [
            "parameter",
            "context",
            "state",
            "nodeOutput",
            "local",
            "surfaceState"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "literal"
      ],
      "properties": {
        "literal": {
          "$ref": "#/$defs/boundedJsonValue"
        }
      }
    },
    "operatorExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "enum": [
            "and",
            "or",
            "not",
            "equal",
            "notEqual",
            "less",
            "lessOrEqual",
            "greater",
            "greaterOrEqual",
            "isNull",
            "isAvailable",
            "add",
            "subtract",
            "multiply",
            "divide",
            "minimum",
            "maximum",
            "clamp",
            "round",
            "conditional",
            "contains",
            "format"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      }
    },
    "expression": {
      "oneOf": [
        {
          "$ref": "#/$defs/literal"
        },
        {
          "$ref": "#/$defs/valueReference"
        },
        {
          "$ref": "#/$defs/operatorExpression"
        }
      ]
    },
    "transform": {
      "oneOf": [
        {
          "$ref": "#/$defs/clampTransform"
        },
        {
          "$ref": "#/$defs/scaleTransform"
        },
        {
          "$ref": "#/$defs/invertTransform"
        },
        {
          "$ref": "#/$defs/deadZoneTransform"
        },
        {
          "$ref": "#/$defs/curveTransform"
        },
        {
          "$ref": "#/$defs/quantizeTransform"
        },
        {
          "$ref": "#/$defs/roundTransform"
        },
        {
          "$ref": "#/$defs/enumMapTransform"
        },
        {
          "$ref": "#/$defs/relativeEncoderTransform"
        },
        {
          "$ref": "#/$defs/unitConvertTransform"
        }
      ]
    },
    "clampTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "minimum",
        "maximum"
      ],
      "properties": {
        "kind": {
          "const": "clamp"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "scaleTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceMinimum",
        "sourceMaximum",
        "targetMinimum",
        "targetMaximum"
      ],
      "properties": {
        "kind": {
          "const": "scale"
        },
        "sourceMinimum": {
          "type": "number"
        },
        "sourceMaximum": {
          "type": "number"
        },
        "targetMinimum": {
          "type": "number"
        },
        "targetMaximum": {
          "type": "number"
        }
      }
    },
    "invertTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "invert"
        }
      }
    },
    "deadZoneTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "minimum",
        "maximum"
      ],
      "properties": {
        "kind": {
          "const": "deadZone"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "curveTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "curveId"
      ],
      "properties": {
        "kind": {
          "const": "curve"
        },
        "curveId": {
          "$ref": "#/$defs/stableIdentifier"
        }
      }
    },
    "quantizeTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "step"
      ],
      "properties": {
        "kind": {
          "const": "quantize"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "roundTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "round"
        }
      }
    },
    "enumMapTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "map"
      ],
      "properties": {
        "kind": {
          "const": "enumMap"
        },
        "map": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/boundedJsonValue"
          }
        },
        "default": {
          "$ref": "#/$defs/boundedJsonValue"
        }
      }
    },
    "relativeEncoderTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dialect"
      ],
      "properties": {
        "kind": {
          "const": "relativeEncoder"
        },
        "dialect": {
          "enum": [
            "twosComplement",
            "binaryOffset",
            "signMagnitude",
            "incrementDecrement"
          ]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "unitConvertTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceUnit",
        "targetUnit"
      ],
      "properties": {
        "kind": {
          "const": "unitConvert"
        },
        "sourceUnit": {
          "$ref": "#/$defs/unitIdentifier"
        },
        "targetUnit": {
          "$ref": "#/$defs/unitIdentifier"
