{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emberlights.local/spec/migration/soundswitch-corpus-manifest-v1.schema.json",
  "title": "EmberLights SoundSwitch Corpus Manifest v1",
  "description": "Portable, content-safe inventory of read-only SoundSwitch migration evidence. SHA-256 values are exactly 64 lowercase hexadecimal characters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "bundleId",
    "sourceVersion",
    "artifacts",
    "missingDependencyCodes"
  ],
  "properties": {
    "format": {
      "const": "emberlights-soundswitch-corpus-manifest"
    },
    "formatVersion": {
      "const": 1
    },
    "bundleId": {
      "type": "string",
      "pattern": "^ssbundle-v1-[0-9a-f]{64}$",
      "maxLength": 256
    },
    "sourceVersion": {
      "type": "string",
      "maxLength": 128
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "missingDependencyCodes": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[a-z0-9._-]+$"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "relativePath",
        "kind",
        "size",
        "sha256",
        "role",
        "availability"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^ssa1-[0-9a-f]{64}$",
          "maxLength": 256
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "kind": {
          "enum": [
            "projectManifest",
            "venueDatabase",
            "autoloopDatabase",
            "extendedAutoloopDatabase",
            "trackMap",
            "autoloopScript",
            "trackScript",
            "recordableData",
            "audio",
            "unknown"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "const": ""
            }
          ]
        },
        "role": {
          "enum": ["required", "conditional", "optional"]
        },
        "availability": {
          "enum": ["presentVerified", "missing", "unreadable", "rejectedUnsafe"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "presentVerified"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    }
  }
}
