{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emberlights.local/spec/migration/soundswitch-migration-report-v1.schema.json",
  "title": "EmberLights SoundSwitch Migration Report v1",
  "description": "Object-level migration outcomes linked to verified source evidence. Raw source payloads are intentionally not representable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "sourceBundleId",
    "sourceVersion",
    "items",
    "aggregateCounts"
  ],
  "properties": {
    "format": {
      "const": "emberlights-soundswitch-migration-report"
    },
    "formatVersion": {
      "const": 1
    },
    "sourceBundleId": {
      "type": "string",
      "pattern": "^ssbundle-v1-[0-9a-f]{64}$",
      "maxLength": 256
    },
    "sourceVersion": {
      "type": "string",
      "maxLength": 128
    },
    "items": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "aggregateCounts": {
      "$ref": "#/$defs/counts"
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "exact",
        "deterministicallyTranslated",
        "approximated",
        "preservedOpaque",
        "unsupported",
        "conflicted",
        "missingDependency",
        "rejectedUnsafe"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "hasByteRange",
        "offset",
        "length",
        "decoderId",
        "decoderVersion"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hasByteRange": {
          "type": "boolean"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "decoderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "decoderVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hasByteRange": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "length": {
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "offset": {
                "const": 0
              },
              "length": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "messageArray": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "itemKind",
        "status",
        "sourceLabel",
        "destinationRef",
        "ruleId",
        "evidence",
        "warnings",
        "blockers"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "itemKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "sourceLabel": {
          "type": "string",
          "maxLength": 4096
        },
        "destinationRef": {
          "type": "string",
          "maxLength": 256
        },
        "ruleId": {
          "type": "string",
          "maxLength": 256
        },
        "evidence": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "warnings": {
          "$ref": "#/$defs/messageArray"
        },
        "blockers": {
          "$ref": "#/$defs/messageArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approximated"
              }
            }
          },
          "then": {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "preservedOpaque"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "conflicted"
              }
            }
          },
          "then": {
            "properties": {
              "destinationRef": {
                "maxLength": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "missingDependency"
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9._-]+$",
                  "maxLength": 256
                }
              }
            }
          }
        }
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact",
        "deterministicallyTranslated",
        "approximated",
        "preservedOpaque",
        "unsupported",
        "conflicted",
        "missingDependency",
        "rejectedUnsafe"
      ],
      "properties": {
        "exact": {"type": "integer", "minimum": 0, "maximum": 100000},
        "deterministicallyTranslated": {"type": "integer", "minimum": 0, "maximum": 100000},
        "approximated": {"type": "integer", "minimum": 0, "maximum": 100000},
        "preservedOpaque": {"type": "integer", "minimum": 0, "maximum": 100000},
        "unsupported": {"type": "integer", "minimum": 0, "maximum": 100000},
        "conflicted": {"type": "integer", "minimum": 0, "maximum": 100000},
        "missingDependency": {"type": "integer", "minimum": 0, "maximum": 100000},
        "rejectedUnsafe": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    }
  }
}
