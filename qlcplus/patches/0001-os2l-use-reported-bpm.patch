+
+void OS2LPlugin::processBeatMessage(const QJsonObject &jsonObj)
+{
+    const double bpm = jsonObj.value("bpm").toDouble(0.0);
+    if (qIsFinite(bpm) == false || bpm < 30.0 || bpm > 300.0)
+    {
+        // Compatibility fallback for older senders that omit BPM. Suppress
+        // duplicate/batched messages while retaining their direct beat input.
+        if (m_lastStableBeat.isValid() == false || m_lastStableBeat.elapsed() >= 50)
+            emitStableBeat();
+        return;
+    }
+
+    const int intervalMs = qBound(200, qRound(60000.0 / bpm), 2000);
+    const bool firstBeat = (m_lastStableBeat.isValid() == false);
+    const bool tempoChanged = (m_stableBeatIntervalMs == 0 ||
+                               qAbs(intervalMs - m_stableBeatIntervalMs) >= 4);
+
+    m_lastBeatMessage.restart();
+    m_stableBeatIntervalMs = intervalMs;
+
+    if (firstBeat)
+    {
+        emitStableBeat();
+        m_stableBeatTimer->start(m_stableBeatIntervalMs);
+        return;
+    }
+
+    // Incoming packets are keep-alive/BPM updates, not the clock itself. This
+    // avoids letting transport jitter or a burst of queued packets become a
+    // burst of QLC+ beats. Only a genuine tempo change reschedules the clock.
+    if (tempoChanged)
+    {
+        const qint64 elapsedMs = m_lastStableBeat.elapsed();
+        if (elapsedMs >= qRound(m_stableBeatIntervalMs * 0.50))
+            emitStableBeat();
+        m_stableBeatTimer->start(m_stableBeatIntervalMs);
+    }
+    else if (m_stableBeatTimer->isActive() == false)
+    {
+        m_stableBeatTimer->start(m_stableBeatIntervalMs);
+    }
+}
+
+void OS2LPlugin::emitStableBeat()
+{
+    if (m_inputUniverse == UINT_MAX)
+        return;
+
+    m_lastStableBeat.restart();
+    emit valueChanged(m_inputUniverse, 0, 8341, 255, "beat");
+}
+
+void OS2LPlugin::stopStableBeat()
+{
+    if (m_stableBeatTimer != NULL)
+        m_stableBeatTimer->stop();
+
+    m_lastBeatMessage.invalidate();
+    m_lastStableBeat.invalidate();
+    m_stableBeatIntervalMs = 0;
+}
+
+void OS2LPlugin::slotEmitStableBeat()
+{
+    if (m_stableBeatIntervalMs <= 0 || m_lastBeatMessage.isValid() == false)
+    {
+        stopStableBeat();
+        return;
+    }
+
+    const int silenceLimitMs = qMax(2000, m_stableBeatIntervalMs * 3);
+    if (m_lastBeatMessage.elapsed() > silenceLimitMs)
+    {
+        stopStableBeat();
+        return;
+    }
+
+    emitStableBeat();
@@ -253 +345 @@ void OS2LPlugin::slotProcessTCPPackets()
-           emit valueChanged(m_inputUniverse, 0, 8341, 255, "beat");
+           processBeatMessage(jsonObj);
