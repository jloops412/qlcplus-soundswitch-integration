  <Engine>
    <InputOutputMap>
      <BeatGenerator BeatType="Plugin" BPM="120" />
      <NetworkServer Type="Native" AutoStart="False" Name="QLC+_DJ_SHOW" Password="" />
      <Universe Name="Universe 1 — FULL RIG — IR4 + WASH + FOCUS A/B + TUBES" ID="0">
        <Input Plugin="OS2L" Name="OS2L line" UID="" Line="0">
          <PluginParameters hostAddress="127.0.0.1" hostPort="9996" />
        </Input>
        <Output Plugin="SoundSwitch Hardware" Name="SoundSwitch Micro — DMX — FULL RIG 334ch" UID="" Line="0">
          <PluginParameters UniverseChannels="334" />
        </Output>
        <Output Plugin="SoundSwitch Hardware" Name="SoundSwitch Control One — DMX 1 — FULL RIG 334ch" UID="" Line="1">
          <PluginParameters UniverseChannels="334" />
        </Output>
      </Universe>
      <Universe Name="Universe 2 - CONTROL ONE INPUT + FEEDBACK ONLY" ID="1">
        <Input Plugin="SoundSwitch Hardware" Name="SoundSwitch Control One — Performance" UID="soundswitch:controlone:midi" Line="0" Profile="SoundSwitch Control One Performance" />
        <Feedback Plugin="SoundSwitch Hardware" Name="SoundSwitch Control One — Surface Feedback" UID="soundswitch:controlone:surface" Line="3" />
      </Universe>
      <Universe Name="Universe 3 — INTERNAL FULL-RIG PRIORITY — WASH + FOCUS A/B" ID="2">
        <Output Plugin="SoundSwitch Hardware" Name="SoundSwitch Hardware — Full-Rig Priority Layer" UID="soundswitch:priority-layer" Line="4">
          <PluginParameters UniverseChannels="334" />
        </Output>
      </Universe>
      <Universe Name="Universe 4 - INTERNAL MOVE + STROBE" ID="3">
        <Output Plugin="SoundSwitch Hardware" Line="5" UID="soundswitch:effect-layer" Name="SoundSwitch Hardware - Native Effect Layer" />
      </Universe>
      <Universe ID="4" Name="Universe 5 - INTERNAL COLOR LATCH">
        <Output Plugin="SoundSwitch Hardware" Line="6" UID="soundswitch:color-latch-layer" Name="SoundSwitch Hardware - Color Latch Layer">
          <PluginParameters UniverseChannels="335" />
        </Output>
      </Universe>
      <Universe ID="5" Name="Universe 6 - INTERNAL COLOR HOLD">
        <Output Plugin="SoundSwitch Hardware" Line="7" UID="soundswitch:color-hold-layer" Name="SoundSwitch Hardware - Color Hold Layer">
          <PluginParameters UniverseChannels="335" />
        </Output>
      </Universe>
    </InputOutputMap>
